@model avatCo.Areas.Profile.ViewModels.DashboardVM
@{
    ViewData["Title"] = "User Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<h3>Profile</h3>

@if (TempData["ProfileSaved"] is string msg)
{
    <div class="alert success">@msg</div>
}

<div class="profile-card">
    <div class="profile-header">
        <div class="profile-title">
            <h2>Welcome, @Model.UserName</h2>
            <div class="muted">@Model.Email</div>
        </div>

        <a class="btn-primary" href="/Profile/Edit">Edit Profile</a>
    </div>

    <div class="profile-body">
        @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
        {
            <img src="@Model.ProfileImageUrl" alt="Profile Picture" class="profile-avatar" width="100" height="100" />
        }

        <ul class="profile-list">
            <li><strong>Full Name:</strong> <span>@(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</span></li>
            <li><strong>Gender:</strong> <span>@(string.IsNullOrWhiteSpace(Model.Gender) ? "-" : Model.Gender)</span></li>
            <li><strong>Date of Birth:</strong> <span>@(Model.DateOfBirth?.ToShortDateString() ?? "-")</span></li>
            <li><strong>Phone:</strong> <span>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</span></li>
            <li><strong>Address:</strong> <span>@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</span></li>

            <li><strong>Orders:</strong> <span>@Model.OrdersCount</span></li>
            <li><strong>Cart Items:</strong> <span>@Model.CartItems.Count</span></li>
        </ul>
    </div>
</div>

<h3 class="section-title">Your Cart</h3>

@if (Model.CartItems.Count == 0)
{
    <div class="muted">Your cart is empty.</div>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CartItems)
            {
                <tr>
                    <td>
                        <div class="cart-product">
                            @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                            {
                                <img class="cart-thumb" src="@item.ProductImageUrl" alt="" width="36" height="36" />
                            }
                            <span>@item.ProductName</span>
                        </div>
                    </td>

                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("0.##")</td>
                    <td>@(item.Quantity * item.UnitPrice).ToString("0.##")</td>
                    <td>
                        <form method="post" action="/Cart/Remove">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CartItemId" value="@item.Id" />
                            <button type="submit" class="btn-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
