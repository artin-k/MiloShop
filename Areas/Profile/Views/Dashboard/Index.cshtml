@model avatCo.Areas.Profile.ViewModels.DashboardVM
@{
    ViewData["Title"] = "پروفایل کاربری";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.BodyClass = "solid-header-page";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-page">

    <div class="page-head">
        <div>
            <h1 class="page-title">پروفایل</h1>
            <p class="page-subtitle">مدیریت اطلاعات حساب و مشاهده سبد خرید</p>
        </div>
        <a class="btn btn-primary" href="/Profile/Edit">ویرایش پروفایل</a>
    </div>

    @if (TempData["ProfileSaved"] is string msg)
    {
        <div class="toast success">
            <span class="dot"></span>
            <span>@msg</span>
        </div>
    }

    @if (TempData["OrderPlaced"] is string orderMsg)
    {
        <div class="toast success">
            <span class="dot"></span>
            <span>@orderMsg</span>
        </div>
    }

    <section class="card profile-card">
        <div class="card-top">
            <div class="title-block">
                <h2 class="card-title">اطلاعات کاربری</h2>
                <div class="muted">مشخصات حساب شما</div>
            </div>

            <a class="btn btn-primary" href="/Profile/Edit">ویرایش پروفایل</a>
        </div>

        <div class="profile-top">
            <div class="profile-identity">
                <div class="avatar-wrap">
                    @if (!string.IsNullOrWhiteSpace(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" alt="Profile Picture" class="avatar" />
                    }
                    else
                    {
                        <div class="avatar placeholder" aria-hidden="true">
                            @(!string.IsNullOrWhiteSpace(Model.UserName) ? Model.UserName.Substring(0, 1).ToUpper() : "U")
                        </div>
                    }
                </div>

                <div class="identity-text">
                    <div class="name">@Model.UserName</div>
                    <div class="muted">@Model.Email</div>
                </div>
            </div>

            <div class="profile-stats">
                <div class="stat">
                    <div class="stat-label">تعداد سفارش‌ها</div>
                    <div class="stat-value">@Model.OrdersCount</div>
                </div>
                <div class="stat">
                    <div class="stat-label">اقلام سبد خرید</div>
                    <div class="stat-value">@Model.CartItems.Count</div>
                </div>
            </div>
        </div>

        <div class="divider"></div>

        <div class="details-grid">
            <div class="field">
                <div class="label">نام کامل</div>
                <div class="value">@(string.IsNullOrWhiteSpace(Model.FullName) ? "-" : Model.FullName)</div>
            </div>

            <div class="field">
                <div class="label">جنسیت</div>
                <div class="value">@(string.IsNullOrWhiteSpace(Model.Gender) ? "-" : Model.Gender)</div>
            </div>

            <div class="field">
                <div class="label">تاریخ تولد</div>
                <div class="value">@(Model.DateOfBirth?.ToShortDateString() ?? "-")</div>
            </div>

            <div class="field">
                <div class="label">شماره تماس</div>
                <div class="value">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</div>
            </div>

            <div class="field span-2">
                <div class="label">آدرس</div>
                <div class="value">@(string.IsNullOrWhiteSpace(Model.Address) ? "-" : Model.Address)</div>
            </div>
        </div>
    </section>

    <section class="card cart-card">
        <div class="card-head">
            <h2 class="section-title">سبد خرید شما</h2>
            <div class="muted">اقلام فعلی سبد</div>
        </div>

        @if (Model.CartItems.Count == 0)
        {
            <div class="empty">
                <div class="empty-title">سبد خرید شما خالی است</div>
                <div class="muted">از فروشگاه محصول اضافه کنید.</div>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table modern cart-items-table">
                    <thead>
                        <tr>
                            <th>محصول</th>
                            <th class="num">تعداد</th>
                            <th class="num">قیمت</th>
                            <th class="num">جمع</th>
                            <th class="actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.CartItems)
                        {
                            <tr>
                                <td>
                                    <div class="cart-product">
                                        @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                                        {
                                            <img class="cart-thumb" src="@item.ProductImageUrl" alt="" />
                                        }
                                        else
                                        {
                                            <div class="cart-thumb placeholder" aria-hidden="true"></div>
                                        }
                                        <div class="cart-meta">
                                            <div class="cart-name">@item.ProductName</div>
                                            <div class="muted small">قیمت واحد: @item.UnitPrice.ToString("N0") تومان</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="num" data-label="Qty">@item.Quantity</td>
                                <td class="num" data-label="Price">@item.UnitPrice.ToString("N0") تومان</td>
                                <td class="num" data-label="Total">@((item.Quantity * item.UnitPrice).ToString("N0")) تومان</td>
                                <td class="actions">
                                    <form method="post" action="/Cart/Remove">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="CartItemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger">حذف</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-wrap cart-actions">
                <a class="btn btn-primary" href="/Cart/Checkout">ادامه و تکمیل سفارش</a>
            </div>
        }
    </section>

</div>
