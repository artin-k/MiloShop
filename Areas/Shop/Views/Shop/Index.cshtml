@model avatCo.Areas.Shop.ViewModels.ShopViewModel;
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["BodyClass"] = "site-page";
}

<link rel="stylesheet" href="~/css/shop.css" asp-append-version="true" />

<section class="shop-shell">

    <!-- Top Bar -->
    <div class="shop-toolbar">
        <div class="toolbar-row">

            <!-- Categories chips -->
            <div class="toolbar-chips">
                <a class="chip is-active" href="/Shop">همه</a>
                @foreach (var c in Model.Categories.Take(10))
                {
                    <a class="chip" href="@Url.Action("Index", "Products", new { categoryId = c.Id })">@c.Name</a>
                }
            </div>

            <!-- Search -->
            <div class="toolbar-search">
                <input id="searchBox" type="text" placeholder="جستجو در محصولات..." autocomplete="off" />
                <span class="search-ico">⌕</span>
                <div id="searchResults" class="search-results d-none"></div>
            </div>

            <!-- Sort + Filters -->
            <div class="toolbar-actions">
                <select class="sort" name="sort" onchange="this.form?.submit?.()">
                    <option value="">پیش‌فرض</option>
                    <option value="new">جدیدترین</option>
                    <option value="cheap">ارزان‌ترین</option>
                    <option value="expensive">گران‌ترین</option>
                </select>

                <button class="btn-filter" type="button" onclick="openFilters()">فیلترها</button>

            </div>

        </div>
    </div>


@*     <!-- Content -->
