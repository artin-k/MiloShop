        </aside> *@

        <!-- Products -->
        <main class="products">
            <div class="products-head">
                <div>
                    <div class="products-title">محصولات</div>
                    <div class="products-sub">@Model.Products.Count() مورد</div>
                </div>

                <a class="see-all" href="/Products">مشاهده همه</a>
            </div>

            @if (!Model.Products.Any())
            {
                <div class="empty">
                    <div class="empty-title">محصولی یافت نشد</div>
                    <div class="empty-sub">فیلترها را تغییر دهید یا جستجو کنید.</div>
                </div>
            }
            else
            {
                <div class="cards">
                    @foreach (var p in Model.Products)
                    {
                        <div class="p-card">
                            <div class="p-img">
                                <img src="@p.ImageUrl" alt="@p.Title" />
                            </div>

                            <div class="p-body">
                                <div class="p-title">@p.Title</div>
                                <div class="p-desc">کیفیت عالی • ارسال سریع</div>

                                <div class="p-foot">
                                    <div class="p-price">@p.Price.ToString("N0") تومان</div>
                                    <button class="p-btn" type="button" onclick="openDetailProductModal(@p.Id)">
                                        جزئیات
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </main>
    </div>
</section>

<!-- Mobile Filters Drawer -->
<div id="filtersDrawer" class="drawer" aria-hidden="true">
    <div class="drawer-backdrop" onclick="closeFilters()"></div>

    <div class="drawer-panel">
        <div class="drawer-head">
            <div class="drawer-title">فیلترها</div>
            <button type="button" class="drawer-close" onclick="closeFilters()">×</button>
        </div>

        <div class="drawer-body">
            <form method="get" action="/Shop" class="filters-form">
                <div class="fg">
                    <div class="lbl">مرتب‌سازی</div>
                    <select class="ctl" name="sort">
                        <option value="">پیش‌فرض</option>
                        <option value="new">جدیدترین</option>
                        <option value="cheap">ارزان‌ترین</option>
                        <option value="expensive">گران‌ترین</option>
                    </select>
                </div>

                <div class="fg">
                    <div class="lbl">بازه قیمت (تومان)</div>
                    <div class="range">
                        <input class="ctl" type="number" name="minPrice" placeholder="از" />
                        <input class="ctl" type="number" name="maxPrice" placeholder="تا" />
                    </div>
                </div>

                <div class="fg">
                    <div class="lbl">دسته‌بندی</div>
                    <div class="list">
                        <label class="check">
                            <input type="radio" name="categoryId" value="" checked />
                            <span>همه</span>
                        </label>

                        @foreach (var c in Model.Categories)
                        {
                            <label class="check">
                                <input type="radio" name="categoryId" value="@c.Id" />
                                <span>@c.Name</span>
                            </label>
                        }
                    </div>
                </div>

                <button class="apply" type="submit">اعمال فیلتر</button>
            </form>
        </div>
    </div>
</div>


<script>
    function openFilters() {
        document.body.classList.add("drawer-open");
        document.getElementById("filtersDrawer")?.classList.add("is-open");
    }

    function closeFilters() {
        document.body.classList.remove("drawer-open");
        document.getElementById("filtersDrawer")?.classList.remove("is-open");
    }

    // Close with ESC
    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") closeFilters();
    });

    // Move drawer to <body> to escape stacking contexts
    document.addEventListener("DOMContentLoaded", function () {
        const d = document.getElementById("filtersDrawer");
        if (d && d.parentElement !== document.body) {
            document.body.appendChild(d);
        }
    });
</script>

