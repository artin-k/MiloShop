@model List<avatCo.Models.Coupon>
@{
    ViewData["Title"] = "کوپن‌های تخفیف";
}

<div class="admin-toolbar">
    <a class="btn" asp-area="Admin" asp-controller="Coupons" asp-action="Create">+ افزودن کوپن</a>
</div>

<div class="admin-card">
    <table class="table">
        <thead>
            <tr>
                <th>کد</th>
                <th>مقدار</th>
                <th>انقضا</th>
                <th>فعال</th>
                <th>عملیات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.Code</td>
                    <td>@c.Value</td>
                    <td>@c.ExpireAt</td>
                    <td>@(c.IsActive ? "✅" : "❌")</td>
                    <td style="display:flex;gap:8px;flex-wrap:wrap;">
                        <a class="btn" asp-area="Admin" asp-controller="Coupons" asp-action="Edit" asp-route-id="@c.Id">ویرایش</a>

                        <form asp-area="Admin" asp-controller="Coupons" asp-action="Delete" asp-route-id="@c.Id" method="post">
                            @Html.AntiForgeryToken()
                            <button class="btn" type="submit">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
