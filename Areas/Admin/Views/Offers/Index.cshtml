@model IEnumerable<avatCo.Models.Offer>
@{
    ViewData["Title"] = "Offers";
}

<h2>Offers</h2>

<p>
    <a class="btn btn-primary" asp-area="Admin" asp-controller="Offers" asp-action="Create">Create Offer</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Kind</th>
            <th>Title</th>
            <th>Active</th>
            <th>Window</th>
            <th>Target</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.Id</td>
                <td>@o.Kind</td>
                <td>@o.Title</td>
                <td>@o.IsActive</td>
                <td>
                    @o.StartsAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                    -
                    @(o.EndsAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "No end")
                </td>
                <td>
                    @if (o.Kind == avatCo.Models.OfferKind.Product)
                    {
                        <span>Product: @o.ProductId</span>
                    }
                    else
                    {
                        <span>Coupon: @o.Coupon?.Code</span>
                    }
                </td>
                <td class="text-end">
                    <a class="btn btn-sm btn-secondary" asp-area="Admin" asp-controller="Offers" asp-action="Edit" asp-route-id="@o.Id">Edit</a>

                    <form asp-area="Admin" asp-controller="Offers" asp-action="Delete" asp-route-id="@o.Id" method="post" style="display:inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-sm btn-danger" type="submit" onclick="return confirm('Delete offer?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
