@model IEnumerable<avatCo.Models.Offer>
@{
    ViewData["Title"] = "Offers";
}

<div class="admin-toolbar">
    <a class="btn" asp-area="Admin" asp-controller="Offers" asp-action="Create">Create Offer</a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Kind</th>
                    <th>Title</th>
                    <th>Active</th>
                    <th>Window</th>
                    <th>Target</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td>@o.Id</td>
                        <td>@o.Kind</td>
                        <td>@o.Title</td>
                        <td>@o.IsActive</td>
                        <td>
                            @o.StartsAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")
                            -
                            @(o.EndsAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "No end")
                        </td>
                        <td>
                            @if (o.Kind == avatCo.Models.OfferKind.Product)
                            {
                                <span>Product: @o.ProductId</span>
                            }
                            else
                            {
                                <span>Coupon: @o.Coupon?.Code</span>
                            }
                        </td>
                        <td style="display:flex;gap:8px;flex-wrap:wrap;">
                            <a class="btn" asp-area="Admin" asp-controller="Offers" asp-action="Edit" asp-route-id="@o.Id">Edit</a>

                            <form asp-area="Admin" asp-controller="Offers" asp-action="Delete" asp-route-id="@o.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn" type="submit" onclick="return confirm('Delete offer?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
