@{
    ViewData["Title"] = "تنظیمات عمومی";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">تنظیمات عمومی سایت</div>
    <a class="btn btn-primary" href="#">+ افزودن کلید جدید</a>
</div>

<div class="card bg-transparent border border-opacity-10">
    <div class="card-body">

        <div class="row g-3 align-items-center mb-3">
            <div class="col-12 col-lg-4">
                <div class="fw-bold">شماره تماس اصلی</div>
                <div class="text-muted small">Phone</div>
            </div>
            <div class="col-12 col-lg-8">
                <input class="form-control" value="98+ 21 8888 8888" />
            </div>
        </div>

        <hr class="border-opacity-10" />

        <div class="row g-3 align-items-center mb-3">
            <div class="col-12 col-lg-4">
                <div class="fw-bold">ایمیل پشتیبانی</div>
                <div class="text-muted small">Email</div>
            </div>
            <div class="col-12 col-lg-8">
                <input class="form-control" value="support@clothingstore.com" />
            </div>
        </div>

        <hr class="border-opacity-10" />

        <div class="row g-3 align-items-center">
            <div class="col-12 col-lg-4">
                <div class="fw-bold">آدرس دفتر مرکزی</div>
                <div class="text-muted small">Address</div>
            </div>
            <div class="col-12 col-lg-8">
                <input class="form-control" value="تهران، خیابان ولیعصر ..." />
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="button">ذخیره تغییرات</button>
            <button class="btn btn-outline-light" type="button">انصراف</button>
        </div>

    </div>
</div>
