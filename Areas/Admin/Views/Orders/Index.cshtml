@model List<avatCo.Models.Order>
@{
    ViewData["Title"] = "سفارش‌ها";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">لیست سفارش‌های ثبت‌شده</div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary border-0">
        هنوز سفارشی ثبت نشده است.
    </div>
}
else
{
    <div class="card bg-transparent border border-opacity-10">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:90px;">شماره</th>
                        <th>کاربر</th>
                        <th style="width:180px;">تاریخ</th>
                        <th style="width:170px;">تحویل گیرنده</th>
                        <th style="width:140px;">تعداد آیتم</th>
                        <th style="width:160px;">مبلغ کل</th>
                        <th style="width:160px;">تخفیف</th>
                        <th style="width:160px;">مبلغ نهایی</th>
                        <th style="width:120px;">وضعیت</th>
                        <th style="width:130px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var o in Model)
                {
                    var itemsCount = o.Items?.Sum(x => x.Quantity) ?? 0;
                    var final = o.FinalAmount ?? (o.TotalAmount - (o.DiscountAmount ?? 0m));

                    <tr>
                        <td>#@o.Id</td>
                        <td>
                            <div class="fw-bold">@o.User?.UserName</div>
                            <div class="text-muted small">@o.User?.Email</div>
                        </td>
                        <td>@o.OrderedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td>@o.RecipientFullName</td>
                        <td>@itemsCount</td>
                        <td>@o.TotalAmount</td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(o.CouponCode))
                            {
                                <span class="badge text-bg-primary">@o.CouponCode</span>
                                <span class="text-muted small ms-2">@((o.DiscountAmount ?? 0m))</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>@final</td>
                        <td><span class="badge text-bg-info">@o.Status</span></td>
                        <td>
                            <a class="btn btn-sm btn-outline-light"
                               asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">
                                جزئیات
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
