@model avatCo.Areas.Auth.ViewModels.LoginVM
@{
    ViewData["Title"] = "Login";
    ViewBag.BodyClass = "login-page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="auth-stage" dir="rtl">

        <!-- Main content area -->
        <div class="auth-body">
            <div class="auth-art" aria-hidden="true">
                <div class="blob">
                    <img src="~/images/auth/login-illustration.png" alt="" />
                </div>
            </div>

            <div class="auth-panel">
                <h1 class="title">ورود</h1>

                <form method="post" asp-area="Auth" asp-controller="Auth" asp-action="Login">
                    @Html.AntiForgeryToken()

                    <div class="field">
                        <input asp-for="Identifier" class="control"
                               placeholder="ایمیل یا نام کاربری"
                               autocomplete="username"
                               name="Identifier" />
                        <span asp-validation-for="Identifier" class="error"></span>
                    </div>

                    <div class="field">
                        <input asp-for="Password" type="password" class="control"
                               placeholder="رمز"
                               autocomplete="current-password"
                               name="Password" />
                        <span asp-validation-for="Password" class="error"></span>
                    </div>

                    <div class="links">
                        <a href="/Auth/ForgotPassword">فراموشی رمز؟</a>
                    </div>

                    <button type="submit" class="btn-primary">ورود</button>

                    <div class="hint">
                        حساب ندارید؟
                        <a href="/Auth/SignUp">ثبت نام</a>
                    </div>
                </form>
            </div>
        </div>
</div>
