@model avatCo.Models.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/animate.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/flexboxgrid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home-hero.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/promos.css" asp-append-version="true" />

<!--hero section-->
<section class="aparat-hero" dir="rtl">

    <div class="aparat-slider">
        @foreach (var s in Model.HeroSlides)
        {
            <div class="slide-item" style="display: none;">
                <div class="slide-bg" style="background-image: url('@Url.Content("~" + s.BackgroundImageUrl)'); background-color: #333;"></div>
                <div class="slide-overlay"></div>

                <div class="slide-content container">
                    <div class="content-box"><a href="c:\users\artin\source\repos\miloshop\areas\home\views\home\index.cshtml">c:\users\artin\source\repos\miloshop\areas\home\views\home\index.cshtml</a>
                        <span class="badge-tag">@s.Badge</span>
                        <h1 class="slide-title">@s.Title</h1>
                        <p class="desc-text">@s.Subtitle</p>

                        <button href="@s.CtaUrl" class="action-btn">@s.CtaText</button>
                    </div>
                </div>
            </div>
        }

        <!-- Navigation Arrows -->
        <div class="slider-nav">
            <button class="nav-arrow prev-arrow"><</button>
            <button class="nav-arrow next-arrow">></button>
        </div>

        <!-- THUMBNAILS MOVED HERE (Inside Slider) -->
        <div class="thumbs-container">
            @foreach (var s in Model.HeroSlides)
            {
                var thumbUrl = string.IsNullOrWhiteSpace(s.ThumbImageUrl) ? s.BackgroundImageUrl : s.ThumbImageUrl;

                <div class="thumb-card">
                    <div class="thumb-img" style="background-image: url('@Url.Content("~" + thumbUrl)'); background-color: #444;"></div>
                    <div class="thumb-info">
                        <span class="thumb-badge">@s.Badge</span>
                    </div>
                </div>
            }
        </div>
    </div>

</section>
<main>

    <!--products / categories-->
    <section class="product-sec-new">
        <div class="row">
            @foreach (var p in Model.NewProducts)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                    <div class="shoping-card">
                        <div class="img-sec">
                            <img src="@p.ImageUrl" alt="@p.Title">
                            <div class="stars">
                                @{
                                    var avg = p.Reviews != null && p.Reviews.Any()
                                    ? (int)Math.Round(p.Reviews.Average(r => r.Rating))
                                    : 0;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= avg)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                }
                            </div>
                        </div>

                        <div class="title">@p.Title</div>

                        <div class="buttons">
                            <div class="right">
                                <span class="price">@p.Price.ToString("N0") تومان</span>
                            </div>
                            <div class="left">
                                <div class="extend-btn">
                                    <a class="b-text" asp-controller="Wishlist" asp-action="Add" asp-route-id="@p.Id">علاقه</a>
                                    <a class="b-icon" asp-controller="Wishlist" asp-action="Add" asp-route-id="@p.Id">
                                        <i class="fas fa-heart"></i>
                                    </a>
                                </div>

                                <div class="extend-btn">
                                    <a class="b-text" asp-controller="Cart" asp-action="Add" asp-route-id="@p.Id">خرید</a>
                                    <a class="b-icon" asp-controller="Cart" asp-action="Add" asp-route-id="@p.Id">
                                        <i class="fas fa-shopping-cart"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!--special offer section-->
    <section class="supper-offer-section">
        <div class="row">
            <div class="col-lg-9">
                <div class="supper-offer-box">
                    <span class="supper-offer-box-title">
                        پیشنهاد شگفت انگیز
                    </span>
                    <div class="body">
                        <div class="row">
                            <div class="col-lg-4">
                                <div class="image-cotainer">
                                    <img src="./images/10.webp" alt="">
                                </div>
                            </div>
                            <div class="col-lg-8">
                                <div class="specification">
                                    <div class="price-row">
                                        <div class="price">1000 تومان</div>
                                        <div class="off"> 60% تخفیف</div>
                                    </div>
                                    <div class="title"> گوشی گلکسی</div>
                                    <div class="conter-down">
                                        <span id="seconds">40</span>:
                                        <span id="minutes">26</span>:
                                        <span id="hours">19</span>
                                    </div>
                                    <div class="remaining-time"> زمان باقی مانده</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="banner">
                    <img src="./images/11.webp" alt="">
                </div>
            </div>
        </div>
    </section>

    <!-- Promo Section: Best Brands and Support -->
    <section class="promo-section" dir="rtl">
        <div class="container">
            <div class="promo-box">

                <a class="promo-card" href="/brands">
                    <img class="promo-img" src="@Url.Content("~/images/promo-brands.jpg")" alt="Best brands" />
                    <span class="promo-overlay"></span>

                    <div class="promo-text">
                        <h3 class="promo-title">بهترین برندها در بازار</h3>
                        <p class="promo-desc">محصولات با کیفیت بالا از برندهای معتبر.</p>
                        <span class="promo-btn">بیشتر بدانید</span>
                    </div>
                </a>

                <a class="promo-card" href="/support">
                    <img class="promo-img" src="@Url.Content("~/images/promo-support.jpg")" alt="24/7 support" />
                    <span class="promo-overlay"></span>

                    <div class="promo-text">
                        <h3 class="promo-title">پشتیبانی ۲۴ ساعته</h3>
                        <p class="promo-desc">پشتیبانی همه‌جانبه برای هر ساعت از روز.</p>
                        <span class="promo-btn">بیشتر بدانید</span>
                    </div>
                </a>

            </div>
        </div>
    </section>



    <!-- Social Media and Support Section -->
    <section class="social-support-section" dir="rtl">
        <div class="container">
            <div class="social-support-wrap">
                <div class="social-head">
                    <h3 class="social-title">همین الان ما رو دنبال کن</h3>
                    <p class="social-sub">در شبکه‌های اجتماعی زیر همراه‌مون باشید و از تخفیف‌ها و محصولات جدید باخبر شوید.</p>
                </div>

                <div class="social-icons">
                    <a href="https://www.whatsapp.com" target="_blank" rel="noopener" class="social-icon wa">
                        <i class="fa-brands fa-whatsapp"></i>
                        <span>WhatsApp</span>
                    </a>

                    <a href="https://www.instagram.com" target="_blank" rel="noopener" class="social-icon ig">
                        <i class="fa-brands fa-instagram"></i>
                        <span>Instagram</span>
                    </a>

                    <a href="https://www.twitter.com" target="_blank" rel="noopener" class="social-icon x">
                        <i class="fa-brands fa-x-twitter"></i>
                        <span>X</span>
                    </a>
                </div>

                <div class="support-info">
                    <p class="support-text">پشتیبانی ۲۴/۷ — پاسخ‌گویی سریع</p>

                    <div class="support-links">
                        <a href="mailto:support@yourdomain.com" class="support-link">
                            <i class="fa-regular fa-envelope"></i>
                            <span>support@yourdomain.com</span>
                        </a>

                        <a href="tel:+1234567890" class="support-link">
                            <i class="fa-solid fa-phone"></i>
                            <span>+123 456 7890</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>


