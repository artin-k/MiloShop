@model avatCo.Models.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* <link rel="stylesheet" href="~/css/animate.css" asp-append-version="true" /> *@
<link rel="stylesheet" href="~/css/home/super-offer.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home/home-category.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home/home-hero.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home/promos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home/feature-cards.css" asp-append-version="true" />

<!--hero section-->
<section class="aparat-hero" dir="rtl">

    <div class="aparat-slider">
        @foreach (var s in Model.HeroSlides)
        {
            <div class="slide-item" style="display: none;">
                <div class="slide-bg" style="background-image: url('@Url.Content("~" + s.BackgroundImageUrl)'); background-color: #333;"></div>
                <div class="slide-overlay"></div>

                <div class="slide-content container">
                    <div class="content-box">
                        <span class="badge-tag">@s.Badge</span>
                        <h1 class="slide-title">@s.Title</h1>
                        <p class="desc-text">@s.Subtitle</p>

                        <button href="@s.CtaUrl" class="action-btn">@s.CtaText</button>
                    </div>
                </div>
            </div>
        }

        <!-- Navigation Arrows -->
        <div class="slider-nav">
            <button class="nav-arrow prev-arrow"><</button>
            <button class="nav-arrow next-arrow">></button>
        </div>

        <!-- THUMBNAILS MOVED HERE (Inside Slider) -->
        <div class="thumbs-container">
            @foreach (var s in Model.HeroSlides)
            {
                var thumbUrl = string.IsNullOrWhiteSpace(s.ThumbImageUrl) ? s.BackgroundImageUrl : s.ThumbImageUrl;

                <div class="thumb-card">
                    <div class="thumb-img" style="background-image: url('@Url.Content("~" + thumbUrl)'); background-color: #444;"></div>
                    <div class="thumb-info">
                        <span class="thumb-badge">@s.Badge</span>
                    </div>
                </div>
            }
        </div>
    </div>

</section>
<main>

    <!--products / categories-->
    <section class="cat-rail" aria-label="Categories">
        <button class="cat-rail__nav is-left" type="button" aria-label="Scroll left">
            ‹
        </button>

        <div class="cat-rail__track" id="catRail" role="list">
            @foreach (var c in Model.Categories)
            {
                <a class="cat-tile"
                   role="listitem"
                   asp-route="ShopIndex"
                   asp-route-categoryId="@c.Id"
                   asp-route-q="@c.Name"
                   asp-route-sort="@c.Description">

                    <span class="cat-tile__icon">
                        @* Option A: if you have an image url *@
                        <img src="@(c.ImageUrl ?? "/img/categories/default.png")" alt="" loading="lazy" />
                    </span>

                    <span class="cat-tile__label">@c.Name</span>
                </a>
            }
        </div>

        <button class="cat-rail__nav is-right" type="button" aria-label="Scroll right">
            ›
        </button>

        <div class="cat-rail__fade is-left" aria-hidden="true"></div>
        <div class="cat-rail__fade is-right" aria-hidden="true"></div>
    </section>


    <!--special offer section-->
    @if (Model.ActiveOffer != null)
    {
        var o = Model.ActiveOffer;
        var endsAt = o.EndsAt?.ToLocalTime();

        <section class="supper-offer-section" dir="rtl" data-ends="@endsAt?.ToString("yyyy-MM-ddTHH:mm:ss")">
            <div class="row">

                <div class="col-lg-9">
                    <div class="supper-offer-box">

                        <div class="supper-offer-head">
                            <h3 class="offer-title">@o.Title</h3>

                            @if (o.EndsAt != null)
                            {
                                <div class="offer-timer">
                                    <span class="t" id="oh">00</span>:
                                    <span class="t" id="om">00</span>:
                                    <span class="t" id="os">00</span>
                                    <span class="timer-label">زمان باقی مانده</span>
                                </div>
                            }
                        </div>

                        <div class="body">

                            @* PRODUCT OFFER *@
                            @if (o.Kind == OfferKind.Product && o.Product != null)
                            {
                                <div class="offer-grid">
                                    <div class="offer-img">
                                        <img src="@o.Product.ImageUrl" alt="@o.Product.Title">
                                    </div>

                                    <div class="offer-info">
                                        <div class="offer-name">@o.Product.Title</div>

                                        <div class="offer-price-row">
                                            @if (o.OfferPrice != null)
                                            {
                                                <span class="offer-price">@o.OfferPrice.Value.ToString("N0") تومان</span>
                                                <span class="offer-badge">@((o.ProductPercentOff ?? 0))% تخفیف</span>
                                            }
                                            else if (o.ProductPercentOff != null)
                                            {
                                                <span class="offer-badge">@o.ProductPercentOff% تخفیف</span>
                                                <span class="offer-price">@o.Product.Price.ToString("N0") تومان</span>
                                            }
                                            else
                                            {
                                                <span class="offer-price">@o.Product.Price.ToString("N0") تومان</span>
                                            }
                                        </div>

                                        <div class="offer-actions">
                                            <a class="btn-primary" asp-controller="Products" asp-action="Details" asp-route-id="@o.Product.Id">مشاهده محصول</a>
                                            <a class="btn-ghost" asp-controller="Cart" asp-action="Add" asp-route-id="@o.Product.Id">افزودن به سبد</a>
                                        </div>
                                    </div>
                                </div>
                            }

                            @* COUPON OFFER *@
                            else if (o.Kind == OfferKind.Coupon && o.Coupon != null)
                            {
                                var c = o.Coupon;

                                <div class="coupon-row">
                                    <div class="coupon-code">
                                        <span class="label">کد:</span>
                                        <span class="code">@c.Code</span>
                                    </div>

                                    <div class="coupon-value">
                                        @if (c.Type == CouponType.Percent)
                                        {
                                            <span class="pill danger">@c.Value.ToString("0")٪ تخفیف</span>
                                        }
                                        else
                                        {
                                            <span class="pill danger">@c.Value.ToString("N0") تومان تخفیف</span>
                                        }

                                        @if (c.MinOrderAmount != null)
                                        {
                                            <span class="pill">حداقل خرید: @c.MinOrderAmount.Value.ToString("N0") تومان</span>
                                        }
                                        @if (c.ExpireAt != null)
                                        {
                                            <span class="pill">تا: @c.ExpireAt.Value.ToLocalTime().ToString("yyyy/MM/dd")</span>
                                        }
                                    </div>

                                    <div class="coupon-actions">
                                        <button type="button" class="btn-ghost copy-btn" data-code="@c.Code">کپی کردن کد</button>
                                        <a class="btn-primary" href="/products">استفاده از تخفیف</a>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    <div class="banner">
                        <img src="@Url.Content(o.BannerImageUrl ?? "~/images/home/milo-offer-banner.webp")" alt="offer" />
                    </div>
                </div>

            </div>
        </section>
    }


    <!-- Promo Section: Best Brands and Support -->
    <section class="promo-section" dir="rtl">
        <div class="container">
            <div class="promo-box">

                <a class="promo-card" href="/brands">
                    <img class="promo-img" src="@Url.Content("~/images/home/promo-brands.jpg")" alt="Best brands" />
                    <span class="promo-overlay"></span>

                    <div class="promo-text">
                        <h3 class="promo-title">بهترین برندها در بازار</h3>
                        <p class="promo-desc">محصولات با کیفیت بالا از برندهای معتبر.</p>
                        <span class="promo-btn">بیشتر بدانید</span>
                    </div>
                </a>

                <a class="promo-card" href="/support">
                    <img class="promo-img" src="@Url.Content("~/images/home/promo-support.jpg")" alt="24/7 support" />
                    <span class="promo-overlay"></span>

                    <div class="promo-text">
                        <h3 class="promo-title">پشتیبانی ۲۴ ساعته</h3>
                        <p class="promo-desc">پشتیبانی همه‌جانبه برای هر ساعت از روز.</p>
                        <span class="promo-btn">بیشتر بدانید</span>
                    </div>
                </a>

            </div>
        </div>
    </section>

    <!--feature products (poster rail)-->
    <section class="poster-rail" dir="rtl" aria-label="Featured">
        <div class="poster-rail__head">
            <h2 class="poster-rail__title">پیشنهادهای ویژه</h2>
            <div class="poster-rail__hint">برای دیدن بیشتر اسکرول کنید</div>
        </div>

        <div class="poster-rail__wrap">
            <button class="poster-nav is-prev" type="button" aria-label="Prev">‹</button>

            <div class="poster-track" id="posterTrack">
                @* Example items *@
                <a class="poster-card" href="#">
                    <img class="poster-img" src="~/images/home/trend-toys.jpg" alt="">
                    <div class="poster-overlay"></div>

                    <div class="poster-content">
                        <div class="poster-kicker">محصولات جدید</div>
                        <div class="poster-title">اسباب‌بازی‌های محبوب</div>
                        <div class="poster-sub">تخفیف تا ۵۰٪</div>
                        <span class="poster-cta">مشاهده</span>
                    </div>
                </a>

                <a class="poster-card" href="#">
                    <img class="poster-img" src="~/images/home/brain-game.jpg" alt="">
                    <div class="poster-overlay"></div>
                    <div class="poster-content">
                        <div class="poster-kicker">پیشنهاد امروز</div>
                        <div class="poster-title">بازی‌های فکری</div>
                        <div class="poster-sub">ارسال رایگان</div>
                        <span class="poster-cta">خرید</span>
                    </div>
                </a>

                <a class="poster-card" href="#">
                    <img class="poster-img" src="~/images/home/gift.jpg" alt="">
                    <div class="poster-overlay"></div>
                    <div class="poster-content">
                        <div class="poster-kicker">ویژه هدیه</div>
                        <div class="poster-title">ست‌های کادویی</div>
                        <div class="poster-sub">بسته‌بندی رایگان</div>
                        <span class="poster-cta">همین الان</span>
                    </div>
                </a>
            </div>

            <button class="poster-nav is-next" type="button" aria-label="Next">›</button>
        </div>

        <div class="poster-dots" id="posterDots" aria-hidden="true"></div>
    </section>


    <!--feature cards -->
    <section class="feature-rail" dir="rtl">
        <div class="feature-rail__head">
            <h2 class="feature-rail__title">
                <span class="accent">تفاوت میلو</span>
                <span class="muted">راه‌های بیشتر برای خرید راحت‌تر</span>
            </h2>
        </div>

        <div class="feature-rail__track" id="featureRail">
            <!-- Card -->
            <a class="feature-card" href="#">
                <div class="feature-card__icon">
                    <!-- use svg or img -->
                    <img src="~/images/icons/" alt="" />
                </div>

                <div class="feature-card__text">
                    <div class="feature-card__headline">
                        دستگاه قدیمی‌تو بده، اعتبار بگیر.
                    </div>
                    <div class="feature-card__desc">
                        و باهاش خرید جدیدت رو ارزون‌تر کن.
                    </div>
                </div>
            </a>

            <a class="feature-card" href="#">
                <div class="feature-card__icon">
                    <img src="@Url.Content("~/images/home/payMoney.jpg")" alt="pay money" />
                </div>
                <div class="feature-card__text">
                    <div class="feature-card__headline">
                        پرداخت کامل یا قسطی.
                    </div>
                    <div class="feature-card__desc">
                        انتخاب با خودته.
                    </div>
                </div>
            </a>

            <a class="feature-card" href="#">
                <div class="feature-card__icon">
                    <img src="~/images/icons/gift.svg" alt="" />
                </div>
                <div class="feature-card__text">
                    <div class="feature-card__headline">
                        هدیه‌ش کن.
                    </div>
                    <div class="feature-card__desc">
                        بسته‌بندی هدیه + پیام اختصاصی رایگان.
                    </div>
                </div>
            </a>

            <a class="feature-card" href="#">
                <div class="feature-card__icon">
                    <img src="~/images/icons/delivery.svg" alt="" />
                </div>
                <div class="feature-card__text">
                    <div class="feature-card__headline">
                        ارسال سریع.
                    </div>
                    <div class="feature-card__desc">
                        تحویل فوری، رایگان یا حضوری.
                    </div>
                </div>
            </a>
        </div>
    </section>

    <!-- Social Media and Support Section -->
    <section class="social-support-section" dir="rtl">
        <div class="container">
            <div class="social-support-wrap">
                <div class="social-head">
                    <h3 class="social-title">همین الان ما رو دنبال کن</h3>
                    <p class="social-sub">در شبکه‌های اجتماعی زیر همراه‌مون باشید و از تخفیف‌ها و محصولات جدید باخبر شوید.</p>
                </div>

                <div class="social-icons wa">
                    <div class="social-icons">
                        <a href="@(Model.WhatsappUrl ?? "https://www.whatsapp.com")" target="_blank" class="social-icon wa">
                            <span class="icon-badge">
                                <img src="~/icons/home/whatsapp.svg" alt="WhatsApp" />
                            </span>
                            <span class="label">WhatsApp</span>
                        </a>

                        <a href="@(Model.InstagramUrl ?? "https://www.instagram.com")" target="_blank" class="social-icon ig">
                            <span class="icon-badge">
                                <img src="~/icons/home/insta.svg" alt="Instagram" />
                            </span>
                            <span class="label">Instagram</span>
                        </a>

                        <a href="@(Model.TwitterUrl ?? "https://www.twitter.com")" target="_blank" class="social-icon x">
                            <span class="icon-badge">
                                <img src="~/icons/home/x.svg" alt="X" />
                            </span>
                            <span class="label">X</span>
                        </a>
                    </div>

                </div>

                <div class="support-info">
                    <p class="support-text">پشتیبانی ۲۴/۷ — پاسخ‌گویی سریع</p>

                    <div class="support-links">
                        <div class="support-links">
                            <a href="mailto:@(Model.SupportEmail ?? "support@yourdomain.com")" class="support-link">
                                <span class="icon-badge">
                                    <img src="~/icons/home/email.svg" alt="Email" />
                                </span>
                                <span class="label">@(Model.SupportEmail ?? "support@yourdomain.com")</span>
                            </a>

                            <a href="tel:@(Model.MainPhone ?? "+1234567890")" class="support-link">
                                <span class="icon-badge">
                                    <img src="~/icons/home/phone.svg" alt="Phone" />
                                </span>
                                <span class="label">@(Model.MainPhone ?? "+123 456 7890")</span>
                            </a>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </section>


</main>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}




