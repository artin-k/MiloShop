@model avatCo.Models.ViewModels.HomePageViewModel
@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <!--hero section-->
    <section class="hero" dir="rtl">
        <div class="swiper heroSwiper">
            <div class="swiper-wrapper">
                @foreach (var s in Model.HeroSlides)
                {
                    <div class="swiper-slide">
                        <div class="heroSlide" style="background-image:url('@Url.Content("~" + s.BackgroundImageUrl)')">
                            <div class="heroOverlay"></div>
                            <div class="heroContent container">
                                <div class="heroPanel">
                                    <div class="heroBadge">@s.Badge</div>
                                    <h1 class="heroTitle">@s.Title</h1>
                                    <p class="heroSub">@s.Subtitle</p>
                                    <a class="heroBtn" href="@s.CtaUrl">@s.CtaText</a>
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>

            <div class="heroNav">
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>

        <div class="swiper heroThumbs">
            <div class="swiper-wrapper">
                @foreach (var s in Model.HeroSlides)
                {
                    var thumb = string.IsNullOrWhiteSpace(s.ThumbImageUrl) ? s.BackgroundImageUrl : s.ThumbImageUrl;

                    <div class="swiper-slide">
                        <div class="heroThumbCard" style="background-image:url('@Url.Content("~" + thumb)')">
                            <div class="heroThumbOverlay"></div>
                            <div class="heroThumbMeta">
                                <div class="heroThumbBadge">@s.Badge</div>
                                @* <div class="heroThumbTitle">@s.Title</div> *@
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
<main>

    <!--products / categories-->
    <section class="product-sec-new">
        <div class="row">
            @foreach (var p in Model.NewProducts)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                    <div class="shoping-card">
                        <div class="img-sec">
                            <img src="@p.ImageUrl" alt="@p.Title">
                            <div class="stars">
                                @{
                                    var avg = p.Reviews != null && p.Reviews.Any()
                                    ? (int)Math.Round(p.Reviews.Average(r => r.Rating))
                                    : 0;
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= avg)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                }
                            </div>
                        </div>

                        <div class="title">@p.Title</div>

                        <div class="buttons">
                            <div class="right">
                                <span class="price">@p.Price.ToString("N0") تومان</span>
                            </div>
                            <div class="left">
                                <div class="extend-btn">
                                    <a class="b-text" asp-controller="Wishlist" asp-action="Add" asp-route-id="@p.Id">علاقه</a>
                                    <a class="b-icon" asp-controller="Wishlist" asp-action="Add" asp-route-id="@p.Id">
                                        <i class="fas fa-heart"></i>
                                    </a>
                                </div>

                                <div class="extend-btn">
                                    <a class="b-text" asp-controller="Cart" asp-action="Add" asp-route-id="@p.Id">خرید</a>
                                    <a class="b-icon" asp-controller="Cart" asp-action="Add" asp-route-id="@p.Id">
                                        <i class="fas fa-shopping-cart"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

