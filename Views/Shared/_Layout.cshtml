<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Avat Co</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/avatCo.styles.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">


    @RenderSection("Styles", required: false)
</head>
<body>
    <header class="header">
        <nav>
            <div class="nav-right">
                <a href=""><i class="fa-solid fa-circle-user"></i></a>
                <a href=""><i class="fa-solid fa-house"></i></a>
                <a href=""><i class="fa-solid fa-cart-shopping"></i></a>
                <a href=""><i class="fa-solid fa-magnifying-glass"></i></a>

            </div>
            <div class="nav-left">
                <div class="register-login-btn">
                    <i class="fa-solid fa-user"></i>
                    <a href="/profile/login"> ثبت نام/ورود </a>
                </div>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="site-footer text-white" dir="rtl">
        <div class="container py-5">
            <div class="row">

                <!-- Column 1: About -->
                <div class="col-12 col-md-3 mb-4">
                    <h5 class="fw-bold">Avat Co</h5>
                    <p class="small">بزرگ‌ترین فروشگاه آنلاین محصولات آزمایشگاهی غرب کشور</p>
                </div>

                <!-- Column 2: Quick Links -->
                <div class="col-12 col-md-3 mb-4">
                    <h6 class="fw-bold">لینک های سریع</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="footer-link">خانه</a></li>
                        <li><a href="#" class="footer-link">فروشگاه</a></li>
                        <li><a href="#" class="footer-link">وبلاگ</a></li>
                        <li><a href="#" class="footer-link">تماس با ما</a></li>
                    </ul>
                </div>

                <!-- Column 3: Support -->
                <div class="col-12 col-md-3 mb-4">
                    <h6 class="fw-bold">پشتیبانی</h6>
                    <ul class="list-unstyled small">
                        <li><a href="#" class="footer-link">سوالات متداول</a></li>
                        <li><a href="#" class="footer-link">پیگیری سفارش</a></li>
                        <li><a href="#" class="footer-link">شرایط بازگشت</a></li>
                        <li><a href="#" class="footer-link">حریم خصوصی</a></li>
                    </ul>
                </div>

                <!-- Column 4: Contact -->
                <div class="col-12 col-md-3 mb-4">
                    <h6 class="fw-bold">ارتباط با ما</h6>
                    <ul class="list-unstyled small">
                        <li><i class="bi bi-telephone me-2"></i> شماره تماس</li>
                        <li><i class="bi bi-envelope me-2"></i> ایمیل</li>
                        <li><i class="bi bi-geo-alt me-2"></i> آدرس</li>
                    </ul>
                </div>

            </div>

            <hr class="border-light">

            <div class="text-center small">© 2025 Avat Co - تمامی حقوق محفوظ است</div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/148efcf8b2.js" crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>



