@using avatCo.Data
@using avatCo.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject MiloDbContext _db
@inject UserManager<ApplicationUser> _userManager
@{
    var cartItemsCount = 0;

    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = _userManager.GetUserId(User);
        if (!string.IsNullOrWhiteSpace(userId))
        {
            cartItemsCount = await _db.CartItems
                .Where(c => c.UserId == userId)
                .SumAsync(c => (int?)c.Quantity) ?? 0;
        }
    }
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FFE52A"/>
    <title>@ViewData["Title"] - Avat Co</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/avatCo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    @RenderSection("Styles", required: false)
</head>
<body class="@ViewBag.BodyClass">
    <header class="header">
        <nav class="navbar">
            <!-- Right Side: Icons -->
            <div class="nav-right">
                <a href="/Auth/Login" class="nav-icon" title="پروفایل">
                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                </a>
                <a href="/shop" class="nav-icon" title="دیدن محصولات">
                    <i class="fa-solid fa-shop" aria-hidden="true"></i>
                </a>
                <a href="/Cart" class="nav-icon" title="سبد خرید">
                    <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                    <span class="cart-badge">@cartItemsCount</span>
                </a>
                <a href="" class="nav-icon" title="جستجو">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Products" asp-action="Index">Admin</a>
                }
            </div>

            <!-- Left Side: Logo -->
            <div class="nav-left">
                <a href="/" class="logo-container">
                    <span class="Logo-text">Milo Shop</span>
                </a>
            </div>
        </nav>
    </header>

    <div class="content-wrapper">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="site-footer" dir="rtl">
        <div class="footer-container">
            <div class="footer-grid">
                <!-- Column 1: About -->
                <div class="footer-column">
                    <h5 class="footer-title">Avat Co</h5>
                    <p class="footer-text">بزرگ‌ترین فروشگاه آنلاین محصولات آزمایشگاهی غرب کشور</p>
                </div>
                <!-- Column 2: Quick Links -->
                <div class="footer-column">
                    <h6 class="footer-title">لینک های سریع</h6>
                    <ul class="footer-list">
                        <li><a href="#" class="footer-link">خانه</a></li>
                        <li><a href="#" class="footer-link">فروشگاه</a></li>
                        <li><a href="#" class="footer-link">وبلاگ</a></li>
                        <li><a href="#" class="footer-link">تماس با ما</a></li>
                    </ul>
                </div>
                <!-- Column 3: Support -->
                <div class="footer-column">
                    <h6 class="footer-title">پشتیبانی</h6>
                    <ul class="footer-list">
                        <li><a href="#" class="footer-link">سوالات متداول</a></li>
                        <li><a href="#" class="footer-link">پیگیری سفارش</a></li>
                        <li><a href="#" class="footer-link">شرایط بازگشت</a></li>
                        <li><a href="#" class="footer-link">حریم خصوصی</a></li>
                    </ul>
                </div>
                <!-- Column 4: Contact -->
                <div class="footer-column">
                    <h6 class="footer-title">ارتباط با ما</h6>
                    <ul class="footer-list">
                        <li><i class="fa-solid fa-phone"></i> شماره تماس</li>
                        <li><i class="fa-solid fa-envelope"></i> ایمیل</li>
                        <li><i class="fa-solid fa-location-dot"></i> آدرس</li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider">
            <div class="footer-copyright">© 2025 Avat Co - تمامی حقوق محفوظ است</div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/header.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>



