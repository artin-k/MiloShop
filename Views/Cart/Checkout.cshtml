@model avatCo.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "تسویه حساب";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.BodyClass = "solid-header-page";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-page">
    <div class="page-head">
        <div>
            <h1 class="page-title">تسویه حساب</h1>
            <p class="page-subtitle">اطلاعات تحویل سفارش را کامل کنید و سپس ثبت نهایی را انجام دهید.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.CouponMessage))
    {
        <div class="toast @(Model.CouponOk ? "success" : "")">
            <span class="dot"></span>
            <span>@Model.CouponMessage</span>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <form method="post" action="/Cart/Checkout">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CouponCode" />

        <section class="card cart-card">
            <div class="card-head">
                <h2 class="section-title">اطلاعات تحویل</h2>
                <div class="muted">این اطلاعات برای ارسال سفارش استفاده می‌شود.</div>
            </div>

            <div class="table-wrap checkout-form-wrap">
                <div class="checkout-grid">
                    <div class="checkout-field">
                        <label asp-for="FullName">نام و نام خانوادگی</label>
                        <input class="checkout-input" asp-for="FullName" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="checkout-field">
                        <label asp-for="PhoneNumber">شماره تماس</label>
                        <input class="checkout-input" asp-for="PhoneNumber" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <div class="checkout-field">
                        <label asp-for="PostalCode">کد پستی (اختیاری)</label>
                        <input class="checkout-input" asp-for="PostalCode" />
                        <span asp-validation-for="PostalCode" class="text-danger"></span>
                    </div>

                    <div class="checkout-field checkout-span-2">
                        <label asp-for="Address">آدرس کامل تحویل</label>
                        <textarea class="checkout-input" asp-for="Address" rows="3"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="checkout-field checkout-span-2">
                        <label asp-for="Note">توضیحات سفارش (اختیاری)</label>
                        <textarea class="checkout-input" asp-for="Note" rows="3"></textarea>
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </section>

        <section class="card cart-card">
            <div class="card-head">
                <h2 class="section-title">خلاصه سفارش</h2>
                <div class="muted">قبل از ثبت نهایی، اقلام و مبلغ را بررسی کنید.</div>
            </div>

            <div class="table-wrap">
                <table class="table modern">
                    <thead>
                        <tr>
                            <th>محصول</th>
                            <th class="num">تعداد</th>
                            <th class="num">قیمت واحد</th>
                            <th class="num">جمع</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="cart-product">
                                        @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                                        {
                                            <img class="cart-thumb" src="@item.ProductImageUrl" alt="" />
                                        }
                                        else
                                        {
                                            <div class="cart-thumb placeholder" aria-hidden="true"></div>
                                        }
                                        <div class="cart-meta">
                                            <div class="cart-name">@item.ProductName</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="num">@item.Quantity</td>
                                <td class="num">@item.UnitPrice.ToString("N0") تومان</td>
                                <td class="num">@((item.UnitPrice * item.Quantity).ToString("N0")) تومان</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-wrap">
                <table class="table modern">
                    <tbody>
                        <tr>
                            <td>مبلغ کل</td>
                            <td class="num">@Model.Subtotal.ToString("N0") تومان</td>
                        </tr>
                        <tr>
                            <td>تخفیف</td>
                            <td class="num">@Model.DiscountAmount.ToString("N0") تومان</td>
                        </tr>
                        <tr>
                            <td>مبلغ نهایی</td>
                            <td class="num">@Model.FinalTotal.ToString("N0") تومان</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="table-wrap checkout-confirm">
                <label class="check-inline">
                    <input asp-for="ConfirmPurchase" type="checkbox" />
                    <span>اطلاعات سفارش را بررسی کردم و ثبت نهایی را تایید می‌کنم.</span>
                </label>
                <span asp-validation-for="ConfirmPurchase" class="text-danger d-block"></span>
            </div>

            <div class="table-wrap cart-actions">
                <a class="btn" href="/Cart">بازگشت به سبد خرید</a>
                <button class="btn btn-primary" type="submit">ثبت نهایی سفارش</button>
            </div>
        </section>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
