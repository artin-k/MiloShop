@model avatCo.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Your Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />

<div class="profile-page">
    <div class="page-head">
        <div>
            <h1 class="page-title">Your Cart</h1>
            <p class="page-subtitle">Review your items and apply a coupon.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.CouponMessage))
    {
        <div class="toast @(Model.CouponOk ? "success" : "")">
            <span class="dot"></span>
            <span>@Model.CouponMessage</span>
        </div>
    }

    <section class="card cart-card">
        <div class="card-head">
            <h2 class="section-title">Cart Items</h2>
            <div class="muted">Items currently in your cart</div>
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="empty">
                <div>
                    <div class="empty-title">Your cart is empty</div>
                    <div class="muted">Browse products and add something you like.</div>
                </div>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table modern">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="num">Qty</th>
                            <th class="num">Price</th>
                            <th class="num">Total</th>
                            <th class="actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="cart-product">
                                        @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                                        {
                                            <img class="cart-thumb" src="@item.ProductImageUrl" alt="" />
                                        }
                                        else
                                        {
                                            <div class="cart-thumb placeholder" aria-hidden="true"></div>
                                        }
                                        <div class="cart-meta">
                                            <div class="cart-name">@item.ProductName</div>
                                            <div class="muted small">Unit: @item.UnitPrice.ToString("0.##")</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="num" data-label="Qty">@item.Quantity</td>
                                <td class="num" data-label="Price">@item.UnitPrice.ToString("0.##")</td>
                                <td class="num" data-label="Total">@((item.Quantity * item.UnitPrice).ToString("0.##"))</td>
                                <td class="actions">
                                    <form method="post" action="/Cart/Remove">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="card cart-card">
        <div class="card-head">
            <h2 class="section-title">Coupon</h2>
            <div class="muted">Enter your coupon code to get a discount.</div>
        </div>

        <div class="table-wrap">
            <form method="post" action="/Cart/ApplyCoupon" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
                @Html.AntiForgeryToken()
                <input class="input" type="text" name="code" value="@Model.CouponCode" placeholder="Coupon code" />
                <button class="btn btn-primary" type="submit">Apply</button>
            </form>
        </div>
    </section>

    <section class="card cart-card">
        <div class="card-head">
            <h2 class="section-title">Summary</h2>
            <div class="muted">Totals and discounts</div>
        </div>

        <div class="table-wrap">
            <table class="table modern">
                <tbody>
                    <tr>
                        <td>Subtotal</td>
                        <td class="num">@Model.Subtotal.ToString("0.##")</td>
                    </tr>
                    <tr>
                        <td>Discount</td>
                        <td class="num">@Model.DiscountAmount.ToString("0.##")</td>
                    </tr>
                    <tr>
                        <td>Total</td>
                        <td class="num">@Model.FinalTotal.ToString("0.##")</td>
                    </tr>
                </tbody>
            </table>
        </div>

        @if (Model.Items.Count > 0)
        {
            <div class="table-wrap">
                <form method="post" action="/Cart/Checkout">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="couponCode" value="@Model.CouponCode" />
                    <button class="btn btn-primary" type="submit">Checkout</button>
                </form>
            </div>
        }
    </section>
</div>
