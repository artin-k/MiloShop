@model MiloShop.Web.ViewModels.HomePageViewModel
@using MiloShop.Domain.Entities
@{
    ViewData["Title"] = "لوازم‌التحریر برای ایده‌های تازه";
    ViewData["Description"] = "خرید آنلاین لوازم‌التحریر، نوشت‌افزار و هدیه‌های خلاقانه از میلوشاپ؛ انتخاب ساده، پرداخت امن و ارسال سریع.";
    ViewData["BodyClass"] = "milo-home";
    ViewBag.BodyClass = "milo-home";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var products = Model.NewProducts.Take(8).ToList();
    var currentUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    string CategoryIcon(string? name)
    {
        var value = (name ?? string.Empty).ToLowerInvariant();
        if (value.Contains("کتاب") || value.Contains("book")) return "fa-book-open";
        if (value.Contains("هنر") || value.Contains("art")) return "fa-palette";
        if (value.Contains("بازی") || value.Contains("game")) return "fa-puzzle-piece";
        if (value.Contains("هدیه") || value.Contains("gift")) return "fa-gift";
        return "fa-pen-ruler";
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/home/milo-landing.css" asp-append-version="true" />
}

@section Head {
    <script type="application/ld+json">
        {"@@context":"https://schema.org","@@type":"WebSite","name":"MiloShop","url":"@($"{Context.Request.Scheme}://{Context.Request.Host}/")","potentialAction":{"@@type":"SearchAction","target":"@($"{Context.Request.Scheme}://{Context.Request.Host}/Shop?q={{search_term_string}}")","query-input":"required name=search_term_string"}}
    </script>
}

<section class="milo-hero" aria-labelledby="hero-title">
    <div class="milo-shell milo-hero__grid">
        <div class="milo-hero__copy">
            <p class="milo-eyebrow"><span></span> از فکر تا کاغذ، با میلو</p>
            <h1 id="hero-title">برای ایده‌هایی که هنوز <em>روی کاغذ</em> نیامده‌اند.</h1>
            <p class="milo-hero__lead">نوشت‌افزار، ابزار خلاقیت و هدیه‌هایی که با دقت انتخاب شده‌اند؛ برای مدرسه، کار و لحظه‌های شخصی شما.</p>
            <div class="milo-actions">
                <a class="milo-button milo-button--primary" asp-route="ShopIndex">ورود به فروشگاه <i class="fa-solid fa-arrow-left" aria-hidden="true"></i></a>
                <a class="milo-button milo-button--text" href="#collections">دیدن مجموعه‌ها</a>
            </div>
            <ul class="milo-trust" aria-label="مزایای خرید از میلوشاپ">
                <li><i class="fa-solid fa-check"></i> انتخاب‌های باکیفیت</li>
                <li><i class="fa-solid fa-check"></i> پرداخت امن</li>
                <li><i class="fa-solid fa-check"></i> ارسال سریع</li>
            </ul>
        </div>

        <div class="milo-hero__art" aria-label="مجموعه‌ای از لوازم‌التحریر رنگی">
            <div class="milo-orbit milo-orbit--one"></div><div class="milo-orbit milo-orbit--two"></div>
            <figure class="milo-photo milo-photo--main"><img src="~/images/hero/hero2.jpg" alt="دفترها و مدادهای رنگی" /></figure>
            <figure class="milo-photo milo-photo--small"><img src="~/images/hero/hero1.jpg" alt="میز کار با نوشت‌افزار رنگی" /></figure>
            <div class="milo-note"><span class="milo-note__mark">م</span><span>انتخاب امروز<br /><strong>شروع یک ایده تازه</strong></span></div>
            <span class="milo-spark milo-spark--one">✦</span><span class="milo-spark milo-spark--two">✦</span>
        </div>
    </div>
</section>

<div class="milo-main">
    <section class="milo-section" id="collections" aria-labelledby="collections-title">
        <div class="milo-shell">
            <header class="milo-section__head">
                <div><p class="milo-kicker">از همین‌جا شروع کن</p><h2 id="collections-title">هر چیزی، برای یک جور خلق کردن.</h2></div>
                <a class="milo-inline-link" asp-route="ShopIndex">همه محصولات <i class="fa-solid fa-arrow-left"></i></a>
            </header>

            @if (Model.Categories.Any())
            {
                <div class="milo-category-grid">
                    @foreach (var category in Model.Categories.Take(6))
                    {
                        <a class="milo-category" asp-route="ShopIndex" asp-route-categoryId="@category.Id">
                            <span class="milo-category__number">@category.Id.ToString("00")</span><i class="fa-solid @CategoryIcon(category.Name)" aria-hidden="true"></i>
                            <span class="milo-category__copy"><strong>@category.Name</strong><small>@(string.IsNullOrWhiteSpace(category.Description) ? "انتخاب‌های تازه و کاربردی" : category.Description)</small></span>
                            <span class="milo-category__arrow">←</span>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="milo-category-grid milo-category-grid--editorial">
                    <a class="milo-category" asp-route="ShopIndex"><span class="milo-category__number">01</span><i class="fa-solid fa-pen-ruler"></i><span class="milo-category__copy"><strong>نوشتن و طراحی</strong><small>برای فکرهایی که باید ثبت شوند</small></span><span class="milo-category__arrow">←</span></a>
                    <a class="milo-category" asp-route="ShopIndex"><span class="milo-category__number">02</span><i class="fa-solid fa-book-open"></i><span class="milo-category__copy"><strong>دفتر و کاغذ</strong><small>صفحه‌های تازه برای شروع تازه</small></span><span class="milo-category__arrow">←</span></a>
                    <a class="milo-category" asp-route="ShopIndex"><span class="milo-category__number">03</span><i class="fa-solid fa-gift"></i><span class="milo-category__copy"><strong>هدیه‌های کوچک</strong><small>برای آدم‌های مهم زندگی</small></span><span class="milo-category__arrow">←</span></a>
                </div>
            }
        </div>
    </section>

    @if (Model.ActiveOffer is not null)
    {
        var offer = Model.ActiveOffer;
        <section class="milo-offer" aria-label="پیشنهاد امروز"><div class="milo-shell"><div class="milo-offer__card">
            <div class="milo-offer__intro"><p class="milo-kicker">پیشنهاد محدود میلو</p><h2>@offer.Title</h2><p>یک انتخاب خوب، با یک دلیل بیشتر برای همین امروز.</p></div>
            @if (offer.Kind == OfferKind.Product && offer.Product is not null)
            {
                var price = offer.OfferPrice ?? offer.Product.SalePrice ?? offer.Product.Price;
                <div class="milo-offer__product">
                    <img src="@(string.IsNullOrWhiteSpace(offer.Product.ImageUrl) ? Url.Content("~/images/hero/hero3.jpg") : offer.Product.ImageUrl)" alt="@offer.Product.Title" />
                    <div><strong>@offer.Product.Title</strong><span>@price.ToString("N0") تومان</span></div>
                    <form method="post" asp-area="" asp-controller="Cart" asp-action="Add" asp-route-id="@offer.Product.Id" asp-route-returnUrl="@currentUrl">@Html.AntiForgeryToken()<button class="milo-button milo-button--light" type="submit">افزودن به سبد</button></form>
                </div>
            }
            else if (offer.Kind == OfferKind.Coupon && offer.Coupon is not null)
            {
                <div class="milo-coupon"><span>کد تخفیف</span><strong>@offer.Coupon.Code</strong><button class="milo-button milo-button--light copy-btn" type="button" data-code="@offer.Coupon.Code">کپی کد</button></div>
            }
            else { <a class="milo-button milo-button--light" asp-route="ShopIndex">مشاهده فروشگاه</a> }
        </div></div></section>
    }
    else if (Model.ActiveCoupon is not null)
    {
        var coupon = Model.ActiveCoupon;
        <section class="milo-offer" aria-label="کد تخفیف فعال"><div class="milo-shell"><div class="milo-offer__card">
            <div class="milo-offer__intro"><p class="milo-kicker">هدیه میلو برای خرید بعدی</p><h2>یک تخفیف کوچک، برای یک شروع تازه.</h2><p>کد را کپی کنید و در مرحله پرداخت وارد کنید.</p></div>
            <div class="milo-coupon"><span>کد تخفیف</span><strong>@coupon.Code</strong><button class="milo-button milo-button--light copy-btn" type="button" data-code="@coupon.Code">کپی کد</button></div>
        </div></div></section>
    }

    <section class="milo-section milo-section--products" aria-labelledby="new-title">
        <div class="milo-shell">
            <header class="milo-section__head"><div><p class="milo-kicker">تازه روی میز</p><h2 id="new-title">انتخاب‌های تازه میلو</h2></div><a class="milo-inline-link" asp-route="ShopIndex" asp-route-sort="new">مشاهده همه <i class="fa-solid fa-arrow-left"></i></a></header>
            @if (products.Any())
            {
                <div class="milo-products">
                    @foreach (var product in products)
                    {
                        var price = product.SalePrice ?? product.Price;
                        var image = string.IsNullOrWhiteSpace(product.ImageUrl) ? Url.Content("~/images/hero/hero3.jpg") : product.ImageUrl;
                        <article class="milo-product">
                            <a class="milo-product__media" asp-route="ShopIndex" asp-route-q="@product.Title"><img src="@image" alt="@product.Title" loading="lazy" />@if (product.SalePrice.HasValue && product.SalePrice < product.Price) { <span>تخفیف</span> }</a>
                            <div class="milo-product__body"><div><p>@(string.IsNullOrWhiteSpace(product.Brand) ? "Milo Select" : product.Brand)</p><h3>@product.Title</h3></div><strong>@price.ToString("N0") <small>تومان</small></strong></div>
                            <form method="post" asp-area="" asp-controller="Cart" asp-action="Add" asp-route-id="@product.Id" asp-route-returnUrl="@currentUrl">@Html.AntiForgeryToken()<button type="submit"><i class="fa-solid fa-plus"></i><span>افزودن به سبد</span></button></form>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="milo-empty-products"><div class="milo-empty-products__visual"><img src="~/images/hero/hero3.jpg" alt="مجموعه نوشت‌افزار رنگی" /></div><div><p class="milo-kicker">قفسه‌ها در حال چیده شدن‌اند</p><h3>به‌زودی انتخاب‌های تازه اینجا هستند.</h3><p>فعلاً می‌توانید مجموعه کامل فروشگاه را ببینید.</p><a class="milo-button milo-button--primary" asp-route="ShopIndex">رفتن به فروشگاه</a></div></div>
            }
        </div>
    </section>

    <section class="milo-story" aria-labelledby="story-title"><div class="milo-shell">
        <div class="milo-story__intro"><p class="milo-kicker">خرید، بدون شلوغی</p><h2 id="story-title">ما انتخاب کردن را ساده نگه می‌داریم.</h2><p>به‌جای صدها انتخاب گیج‌کننده، محصولاتی کاربردی و خوش‌ساخت را کنار هم می‌گذاریم تا شما سریع‌تر به چیزی که می‌خواهید برسید.</p></div>
        <ol class="milo-steps"><li><span>01</span><i class="fa-solid fa-magnifying-glass"></i><div><h3>پیدا کن</h3><p>با دسته‌بندی و جست‌وجوی ساده.</p></div></li><li><span>02</span><i class="fa-solid fa-basket-shopping"></i><div><h3>انتخاب کن</h3><p>قیمت و موجودی شفاف، بدون حدس.</p></div></li><li><span>03</span><i class="fa-solid fa-box-open"></i><div><h3>تحویل بگیر</h3><p>پرداخت امن و پیگیری سفارش.</p></div></li></ol>
    </div></section>

    <section class="milo-final" aria-labelledby="final-title"><div class="milo-shell"><div class="milo-final__card">
        <span class="milo-final__shape milo-final__shape--one"></span><span class="milo-final__shape milo-final__shape--two"></span><p class="milo-kicker">یک صفحه سفید منتظر توست</p><h2 id="final-title">ایده بعدی‌ات را با چه چیزی شروع می‌کنی؟</h2><a class="milo-button milo-button--light" asp-route="ShopIndex">کشف محصولات <i class="fa-solid fa-arrow-left"></i></a>
    </div></div></section>
</div>

@section Scripts {
    <script>
        document.addEventListener("click", async (event) => {
            const button = event.target.closest(".copy-btn");
            if (!button) return;
            try { await navigator.clipboard.writeText(button.dataset.code); button.textContent = "کپی شد"; }
            catch { button.textContent = button.dataset.code; }
        });
    </script>
}
