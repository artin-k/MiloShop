@{
    var currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
    string Active(string name) => currentController == name ? "sb-link active" : "sb-link";
}

<div class="sb-brand">
    <div class="sb-logo">Milo Shop</div>
    <div class="sb-sub">پنل مدیریت</div>
</div>

<nav class="sb-nav">
    <a class="@Active("Home")" asp-area="Admin" asp-controller="Home" asp-action="Index">داشبورد</a>

    <a class="@Active("Products")" asp-area="Admin" asp-controller="Products" asp-action="Index">مدیریت محصولات</a>
    <a class="@Active("Categories")" asp-area="Admin" asp-controller="Categories" asp-action="Index">دسته‌بندی‌ها</a>

    <a class="@Active("Orders")" asp-area="Admin" asp-controller="Orders" asp-action="Index">سفارشات</a>
    <a class="@Active("Coupons")" asp-area="Admin" asp-controller="Coupons" asp-action="Index">کوپن‌های تخفیف</a>
    <a class="@Active("Offers")" asp-area="Admin" asp-controller="Offers" asp-action="Index">تخفیف روی محصول</a>
    <a class="@Active("Settings")" asp-area="Admin" asp-controller="Settings" asp-action="General">تنظیمات عمومی</a>
    <a class="sb-link" asp-area="" asp-controller="Shop" asp-action="Index">برگشت به فروشگاه</a>

</nav>
