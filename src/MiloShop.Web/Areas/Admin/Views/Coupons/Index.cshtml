@model List<MiloShop.Domain.Entities.Coupon>
@{
    ViewData["Title"] = "Coupons";
}

<div class="admin-toolbar">
    <a class="btn" asp-area="Admin" asp-controller="Coupons" asp-action="Create">+ Add Coupon</a>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Type</th>
                    <th>Value</th>
                    <th>Expire At</th>
                    <th>Min Order</th>
                    <th>Usage</th>
                    <th>Active</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coupon in Model)
                {
                    <tr>
                        <td>@coupon.Code</td>
                        <td>@(coupon.Type == CouponType.Percent ? "Percent" : "Fixed")</td>
                        <td>@(coupon.Type == CouponType.Percent ? $"{coupon.Value}%" : coupon.Value.ToString("N0"))</td>
                        <td>@(coupon.ExpireAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td>@(coupon.MinOrderAmount?.ToString("N0") ?? "-")</td>
                        <td>@(coupon.UsageLimit.HasValue ? $"{coupon.UsedCount}/{coupon.UsageLimit}" : $"{coupon.UsedCount}/-")</td>
                        <td>@(coupon.IsActive ? "Yes" : "No")</td>
                        <td class="d-flex gap-2 flex-wrap">
                            <a class="btn" asp-area="Admin" asp-controller="Coupons" asp-action="Edit" asp-route-id="@coupon.Id">Edit</a>
                            <form asp-area="Admin" asp-controller="Coupons" asp-action="Delete" asp-route-id="@coupon.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button class="btn" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
