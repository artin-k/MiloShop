@model MiloShop.Domain.Entities.Coupon
@{
    ViewData["Title"] = "Create Coupon";
}

<div class="admin-card">
    <form method="post">
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        <div class="form-row">
            <div>
                <div class="form-label">Code</div>
                <div class="form-hint">Example: SPRING2024</div>
            </div>
            <div>
                <input class="input" asp-for="Code" />
                @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-row">
            <div>
                <div class="form-label">Type</div>
                <div class="form-hint">Percent or fixed amount</div>
            </div>
            <div>
                <select class="input" asp-for="Type" asp-items="Html.GetEnumSelectList<MiloShop.Domain.Entities.CouponType>()"></select>
                @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-row">
            <div>
                <div class="form-label">Value</div>
                <div class="form-hint">Percent (1-100) or fixed amount</div>
            </div>
            <div>
                <input class="input" asp-for="Value" type="number" step="0.01" min="0" />
                @Html.ValidationMessageFor(m => m.Value, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-row">
            <div>
                <div class="form-label">Expire At</div>
                <div class="form-hint">Leave empty for no expiry</div>
            </div>
            <div>
                <input class="input" asp-for="ExpireAt" type="date" />
                @Html.ValidationMessageFor(m => m.ExpireAt, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-row">
            <div>
                <div class="form-label">Usage Limit</div>
                <div class="form-hint">Leave empty for unlimited</div>
            </div>
            <div>
                <input class="input" asp-for="UsageLimit" type="number" min="0" />
                @Html.ValidationMessageFor(m => m.UsageLimit, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-row">
            <div>
                <div class="form-label">Min Order Amount</div>
                <div class="form-hint">Minimum cart total to apply this coupon</div>
            </div>
            <div>
                <input class="input" asp-for="MinOrderAmount" type="number" step="0.01" min="0" />
                @Html.ValidationMessageFor(m => m.MinOrderAmount, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-row">
            <div>
                <div class="form-label">Active</div>
                <div class="form-hint">Uncheck to disable this coupon</div>
            </div>
            <div>
                <input type="checkbox" asp-for="IsActive" />
            </div>
        </div>

        <div style="display:flex;gap:10px;margin-top:16px;">
            <button class="btn" type="submit">Save</button>
            <a class="btn" asp-area="Admin" asp-controller="Coupons" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
