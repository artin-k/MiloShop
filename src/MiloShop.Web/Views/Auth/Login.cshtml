@model MiloShop.Web.ViewModels.Auth.LoginVM
@{ ViewData["Title"] = "ورود به میلوشاپ"; }
<section class="form-panel">
    <p class="eyebrow">WELCOME BACK / MILOSHOP</p>
    <h1>دوباره خوش آمدی.</h1>
    <form asp-controller="Auth" asp-action="Login" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
        <label asp-for="Identifier">ایمیل یا نام کاربری</label>
        <input asp-for="Identifier" autocomplete="username" />
        <span asp-validation-for="Identifier" class="error"></span>
        <label asp-for="Password">رمز عبور</label>
        <input asp-for="Password" type="password" autocomplete="current-password" />
        <span asp-validation-for="Password" class="error"></span>
        <label class="check-inline"><input asp-for="RememberMe" /> مرا به خاطر بسپار</label>
        <button class="button button--primary" type="submit">ورود ←</button>
    </form>
    <p class="form-hint">حساب نداری؟ <a asp-controller="Auth" asp-action="SignUp" asp-route-returnUrl="@ViewData["ReturnUrl"]">ثبت نام</a></p>
</section>
