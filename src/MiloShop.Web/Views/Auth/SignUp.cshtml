@model MiloShop.Web.ViewModels.Auth.SignUpVM
@{ ViewData["Title"] = "ساخت حساب میلوشاپ"; }
<section class="form-panel">
    <p class="eyebrow">YOUR NEXT CHAPTER / MILOSHOP</p>
    <h1>یک شروع تازه.</h1>
    <form asp-controller="Auth" asp-action="SignUp" method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
        <label asp-for="UserName">نام کاربری</label><input asp-for="UserName" autocomplete="username" />
        <span asp-validation-for="UserName" class="error"></span>
        <label asp-for="Email">ایمیل</label><input asp-for="Email" autocomplete="email" type="email" />
        <span asp-validation-for="Email" class="error"></span>
        <label asp-for="Password">رمز عبور</label><input asp-for="Password" type="password" autocomplete="new-password" />
        <span asp-validation-for="Password" class="error"></span>
        <label asp-for="ConfirmPassword">تکرار رمز عبور</label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="error"></span>
        <button class="button button--primary" type="submit">ساخت حساب ←</button>
    </form>
    <p class="form-hint">حساب داری؟ <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">ورود به حساب</a></p>
</section>
