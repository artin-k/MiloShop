@{ var cartItemsCount = (int)(ViewData["CartItemsCount"] ?? 0); }
    <header class="header">
        <nav class="navbar">
            <div class="nav-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Profile" class="nav-icon" title="پروفایل">
                        <i class="fa-regular fa-user" aria-hidden="true"></i>
                    </a>
                    <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="nav-logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-icon nav-icon-btn" title="خروج">
                            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
                        </button>
                    </form>
                }
                else
                {
                    <a href="/Auth/Login" class="nav-icon" title="ورود">
                        <i class="fa-regular fa-user" aria-hidden="true"></i>
                    </a>
                }
                <a href="/shop" class="nav-icon" title="دیدن محصولات">
                    <i class="fa-solid fa-shop" aria-hidden="true"></i>
                </a>
                <a href="/Cart" class="nav-icon" title="سبد خرید">
                    <i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>
                    <span class="cart-badge">@cartItemsCount</span>
                </a>
                <a href="/Shop#searchBox" class="nav-icon" title="جستجو">
                    <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-admin" asp-area="Admin" asp-controller="Products" asp-action="Index">مدیریت</a>
                }
            </div>

            <div class="nav-center" aria-label="ناوبری اصلی">
                <a href="/">خانه</a>
                <a href="/Shop">فروشگاه</a>
                <a href="/#collections">مجموعه‌ها</a>
            </div>

            <div class="nav-left">
                <a href="/" class="logo-container">
                    <span class="logo-mark">م</span>
                    <span class="Logo-text">Milo Shop</span>
                </a>
            </div>
        </nav>
    </header>
