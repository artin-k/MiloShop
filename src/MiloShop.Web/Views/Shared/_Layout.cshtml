@{
    var scene = ViewData["Scene"] is true;
    var title = ViewData["Title"]?.ToString() ?? "میلوشاپ";
    var description = ViewData["Description"]?.ToString() ?? "نوشت‌افزار، ابزار خلاقیت و هدیه از میلوشاپ.";
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}
<!doctype html>
<html lang="fa" dir="@(scene ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#05070a" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="canonical" href="@canonical" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:type" content="website" />
    <link rel="stylesheet" href="~/vendor/threeui/secret-pathways-assets/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/threeui/kage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/milo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(scene ? "scene-page" : "commerce-page")" data-layout-hero="b" data-layout-story="b" data-layout-gallery="b" data-layout-curriculum="b" data-layout-closing="b" data-layout-footer="b">
    <a class="skip-link" href="#main">پرش به محتوا</a>
    @if (scene) { <partial name="_Scene" /> }
    <partial name="_Header" />
    <div class="page" id="top">
        <main id="main" class="@(scene ? "" : "shop-shell")">
            @if (!scene && User.IsInRole("Admin") && Context.Request.Path.StartsWithSegments("/Admin"))
            {
                <partial name="_AdminNav" />
            }
            @if (TempData["OrderError"] is string orderError) { <p class="notice error" role="alert">@orderError</p> }
            @if (TempData["OrderPlaced"] is string orderPlaced) { <p class="notice" role="status">@orderPlaced</p> }
            @RenderBody()
        </main>
        <partial name="_Footer" />
    </div>
    @if (scene)
    {
        <div id="fg-sky" aria-hidden="true"></div>
        <div class="rail" id="rail"></div>
        <script src="~/js/scene-accessibility.js" asp-append-version="true"></script>
        <script src="~/vendor/threeui/secret-pathways-assets/three.min.js"></script>
        <script src="~/vendor/threeui/kage.js" asp-append-version="true"></script>
    }
    <script src="~/js/milo.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
