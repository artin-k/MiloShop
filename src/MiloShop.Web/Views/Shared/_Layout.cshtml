@{
    var scene = ViewData["Scene"] is true;
    var title = ViewData["Title"]?.ToString() ?? "میلوشاپ";
    var description = ViewData["Description"]?.ToString() ?? "نوشت‌افزار، ابزار خلاقیت و هدیه از میلوشاپ.";
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
}
<!doctype html>
<html lang="fa" dir="@(scene ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>@title</title>
    <meta name="description" content="@description" />
    <meta name="theme-color" content="#f5f2e9" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="canonical" href="@canonical" />
    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:type" content="website" />
    <link rel="preload" href="~/fonts/Vazirmatn-Regular.woff2" as="font" type="font/woff2" crossorigin />
    @if (scene)
    {
        <link rel="stylesheet" href="~/vendor/threeui/secret-pathways-assets/fonts.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/vendor/threeui/kage.css" asp-append-version="true" />
    }
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/milo.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/themes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/liquid-glass.css" asp-append-version="true" />
    <noscript><link rel="stylesheet" href="~/css/no-script.css" asp-append-version="true" /></noscript>
    @await RenderSectionAsync("Styles", required: false)
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@(scene ? "scene-page" : "commerce-page") @(ViewData["Home"] is true ? "stationery-home" : "")" data-layout-hero="b" data-layout-story="b" data-layout-gallery="b" data-layout-curriculum="b" data-layout-closing="b" data-layout-footer="b">
    <partial name="_StationeryIcons" />
    <a class="skip-link" href="#main">پرش به محتوا</a>
    @if (scene) { <partial name="_Scene" /> }
    <partial name="_Header" />
    <div class="page" id="top">
        <main id="main" class="@(scene ? "" : "shop-shell")">
            @if (!scene && User.IsInRole("Admin") && Context.Request.Path.StartsWithSegments("/Admin"))
            {
                <partial name="_AdminNav" />
            }
            @if (TempData["OrderError"] is string orderError) { <p class="notice error" role="alert">@orderError</p> }
            @if (TempData["OrderPlaced"] is string orderPlaced) { <p class="notice" role="status">@orderPlaced</p> }
            @RenderBody()
        </main>
        @await Component.InvokeAsync("Footer")
    </div>
    @if (scene || ViewData["ProductList"] is true || ViewData["Home"] is true) { <partial name="_Comparison" /> }
    @if (scene)
    {
        <div id="fg-sky" aria-hidden="true"></div>
        <div class="rail" id="rail"></div>
        <script defer src="~/js/scene-accessibility.js" asp-append-version="true"></script>
        <script defer src="~/vendor/threeui/secret-pathways-assets/three.min.js" asp-append-version="true"></script>
        <script defer src="~/vendor/threeui/kage.js" asp-append-version="true"></script>
    }
    <script defer src="~/js/milo.js" asp-append-version="true"></script>
    @if (!scene && User.IsInRole("Admin") && Context.Request.Path.StartsWithSegments("/Admin"))
    {
        <script type="module" src="~/vendor/liquid-glass/navigation.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
