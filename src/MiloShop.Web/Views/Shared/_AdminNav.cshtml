@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var sections = new[] {
        ("AdminHome", "AdminDashboard", "داشبورد"),
        ("AdminHomepage", "AdminHomepageIndex", "صفحه اصلی"),
        ("AdminTestimonials", "AdminTestimonialsIndex", "دیدگاه‌ها"),
        ("AdminProducts", "AdminProductsIndex", "محصولات"),
        ("AdminCategories", "AdminCategoriesIndex", "دسته‌بندی‌ها"),
        ("AdminOrders", "AdminOrdersIndex", "سفارش‌ها"),
        ("AdminOffers", "AdminOffersIndex", "پیشنهادها"),
        ("AdminCoupons", "AdminCouponsIndex", "کدهای تخفیف"),
        ("AdminSettings", "AdminSettingsIndex", "تنظیمات"),
    };
}
<nav class="admin-nav glass-links" aria-label="مدیریت فروشگاه" data-liquid-nav="admin">
    @foreach (var (section, route, label) in sections)
    {
        <a asp-route="@route" aria-current="@(controller == section ? "page" : null)">@label</a>
    }
</nav>
