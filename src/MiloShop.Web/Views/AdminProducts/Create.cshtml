@model MiloShop.Web.ViewModels.Admin.ProductUpsertVm
@{
    ViewData["Title"] = "افزودن محصول";
    var categories = ViewBag.Categories as List<MiloShop.Domain.Entities.Category> ?? new();
}

<div class="card bg-transparent border border-opacity-10 p-3">
    <form method="post" enctype="multipart/form-data"
          asp-controller="AdminProducts" asp-action="Create">

        @Html.AntiForgeryToken()
        <div class="text-danger">
            @Html.ValidationSummary(excludePropertyErrors: false)
        </div>

        <div class="mb-3">
            <label class="form-label">دسته‌بندی</label>
            <select class="form-select" asp-for="CategoryId" required>
                <option value="">انتخاب کنید</option>
                @foreach (var c in categories)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </select>
            <span class="text-danger">@Html.ValidationMessageFor(m => m.CategoryId)</span>
        </div>

        <div class="row g-3">
            <div class="col-12 col-lg-6">
                <label class="form-label">عنوان</label>
                <input class="form-control" asp-for="Title" />
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Title)</span>
            </div>

            <div class="col-12 col-lg-3">
                <label class="form-label">قیمت</label>
                <input class="form-control" asp-for="Price" type="number" step="0.01" />
                <span class="text-danger">@Html.ValidationMessageFor(m => m.Price)</span>
            </div>

            <div class="col-12 col-lg-3">
                <label class="form-label">قیمت تخفیف</label>
                <input class="form-control" asp-for="SalePrice" type="number" step="0.01" />
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label" asp-for="ShortDescription">مشخصات کوتاه برای کارت محصول</label>
            <input class="form-control" asp-for="ShortDescription" placeholder="مثلاً کاغذ ۱۲۰ گرمی، نقطه‌دار، سبز و آجری" />
        </div>

        <div class="mt-3">
            <label class="form-label">توضیحات</label>
            <textarea class="form-control" asp-for="Description" rows="5"></textarea>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12 col-lg-4">
                <label class="form-label">موجودی</label>
                <input class="form-control" asp-for="StockQuantity" type="number" />
            </div>
            <div class="col-12 col-lg-4">
                <label class="form-label">برند</label>
                <input class="form-control" asp-for="Brand" />
            </div>
            <div class="col-12 col-lg-4">
                <label class="form-label">جنس</label>
                <input class="form-control" asp-for="Material" />
            </div>
        </div>

        <div class="mt-3">
            <label class="form-label" asp-for="ImageFile">تصویر محصول</label>
            <input class="form-control" asp-for="ImageFile" type="file" accept=".svg,.jpg,.jpeg,.png,.webp" aria-describedby="shelf-photo-tip" />
            <small id="shelf-photo-tip">برای نماد برداری، SVG ساده تا ۱۲۸ کیلوبایت بارگذاری کنید. برای عکس قفسه، یک عکس روبه‌رو با زمینهٔ شفاف (PNG) و کادر عمودی ۸۰۰ × ۱۲۰۰ پیکسل انتخاب کنید. محصول را وسط کادر و نزدیک لبهٔ پایین بگذارید.</small>
            <span class="text-danger">@Html.ValidationMessage("ImageFile")</span>
        </div>

        <label asp-for="HomepagePlacement">نمایش در محصولات صفحه اصلی</label>
        <select asp-for="HomepagePlacement">
            <option value="Automatic">خودکار (جدیدترین‌ها)</option>
            <option value="Featured">در اولویت نمایش</option>
            <option value="Hidden">پنهان از صفحه اصلی</option>
        </select>
        <div class="form-check mt-3">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label">فعال</label>
        </div>

        <div class="form-check mt-2">
            <input class="form-check-input" asp-for="IsSpecialOffer" />
            <label class="form-check-label">پیشنهاد ویژه</label>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button class="btn btn-primary" type="submit">ذخیره</button>
            <a class="btn btn-outline-light" asp-controller="AdminProducts" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
