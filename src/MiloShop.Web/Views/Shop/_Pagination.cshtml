@model MiloShop.Web.ViewModels.Shop.ShopViewModel
@{ var pages = (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize); }
@if (pages > 1)
{
    <nav class="pagination" aria-label="صفحه‌بندی محصولات">
        @if (Model.Page > 1) { <a class="button" asp-route="ShopIndex" asp-route-page="@(Model.Page - 1)" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort" asp-route-categoryId="@Model.CategoryId" asp-route-brand="@Model.SelectedBrand" asp-route-material="@Model.SelectedMaterial" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice">صفحه قبل</a> }
        <span aria-current="page">@Model.Page از @pages</span>
        @if (Model.Page < pages) { <a class="button" asp-route="ShopIndex" asp-route-page="@(Model.Page + 1)" asp-route-q="@Model.Query" asp-route-sort="@Model.Sort" asp-route-categoryId="@Model.CategoryId" asp-route-brand="@Model.SelectedBrand" asp-route-material="@Model.SelectedMaterial" asp-route-minPrice="@Model.MinPrice" asp-route-maxPrice="@Model.MaxPrice">صفحه بعد</a> }
    </nav>
}
