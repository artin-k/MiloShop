@model List<MiloShop.Domain.Entities.Category>
@{
    ViewData["Title"] = "دسته‌بندی‌ها";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="text-muted">مدیریت دسته‌بندی‌ها</div>
    <a class="btn btn-primary" asp-controller="AdminCategories" asp-action="Create">
        + افزودن دسته‌بندی
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary border-0">
        هنوز هیچ دسته‌بندی‌ای ثبت نشده.
    </div>
}
else
{
    <div class="card bg-transparent border border-opacity-10">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:90px;">تصویر</th>
                        <th>نام</th>
                        <th>توضیحات</th>
                        <th style="width:180px;">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            @if (c.Icon == null && !string.IsNullOrWhiteSpace(c.ImageUrl))
                            {
                                <img src="@c.ImageUrl" class="rounded" alt="" loading="lazy" decoding="async" style="width:36px;height:36px;object-fit:contain;" />
                            }
                            else { <partial name="_Icon" model="@(c.Icon ?? StationeryIcon.ForCategory(c.Name))" /> }
                        </td>
                        <td>@c.Name</td>
                        <td class="text-muted">@c.Description</td>
                        <td class="d-flex gap-2">
                            <a class="btn btn-sm btn-outline-light"
                               asp-controller="AdminCategories" asp-action="Edit" asp-route-id="@c.Id">
                                ویرایش
                            </a>

                            <form method="post"
                                  asp-controller="AdminCategories" asp-action="Delete" asp-route-id="@c.Id"
                                  onsubmit="return confirm('حذف شود؟');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-outline-danger" type="submit">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
