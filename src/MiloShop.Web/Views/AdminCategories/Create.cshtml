@model MiloShop.Web.ViewModels.Admin.CategoryUpsertVm
@{
    ViewData["Title"] = "افزودن دسته‌بندی";
}

<div class="card bg-transparent border border-opacity-10 p-3">
    <form method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">نام</label>
            <input class="form-control" asp-for="Name" />
            <span class="text-danger">@Html.ValidationMessageFor(m => m.Name)</span>
        </div>

        <div class="mb-3">
            <label class="form-label">توضیحات</label>
            <textarea class="form-control" asp-for="Description" rows="4"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label" asp-for="ImageFile">تصویر یا نماد SVG</label>
            <input class="form-control" asp-for="ImageFile" type="file" accept=".svg,.jpg,.jpeg,.png,.webp" aria-describedby="category-icon-help" />
            <small id="category-icon-help">برای نمایش SVG ساده (حداکثر ۱۲۸ کیلوبایت)، گزینهٔ «تصویر بارگذاری‌شده یا نماد خودکار» را انتخاب کنید.</small>
            <span class="text-danger">@Html.ValidationMessageFor(m => m.ImageFile)</span>
        </div>

        <label asp-for="Icon">نماد کنار دسته‌بندی</label>
        <select asp-for="Icon">
            <option value="">تصویر بارگذاری‌شده یا نماد خودکار</option>
            @foreach (var icon in StationeryIcon.Options)
            {
                <option value="@icon.Key">@icon.Value</option>
            }
        </select>
        <span asp-validation-for="Icon"></span>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">ذخیره</button>
            <a class="btn btn-outline-light" asp-controller="AdminCategories" asp-action="Index">انصراف</a>
        </div>
    </form>
</div>
