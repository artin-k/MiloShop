@model MiloShop.Web.ViewModels.Profile.UpdateProfileVM
@{ ViewData["Title"] = "ویرایش حساب | میلوشاپ"; }
<section class="form-panel"><p class="eyebrow">YOUR DETAILS</p><h1>اطلاعات شما.</h1>
    <form asp-controller="Profile" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
        <label asp-for="UserName">نام کاربری</label><input asp-for="UserName" /><span asp-validation-for="UserName" class="error"></span>
        <label asp-for="FullName">نام و نام خانوادگی</label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="error"></span>
        <label asp-for="PhoneNumber">شماره تماس</label><input asp-for="PhoneNumber" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="error"></span>
        <label asp-for="Address">آدرس</label><textarea asp-for="Address" autocomplete="street-address"></textarea><span asp-validation-for="Address" class="error"></span>
        <label asp-for="DateOfBirth">تاریخ تولد</label><input asp-for="DateOfBirth" type="date" />
        <label asp-for="Gender">جنسیت (اختیاری)</label><select asp-for="Gender"><option value="">انتخاب نشده</option><option value="Male">مرد</option><option value="Female">زن</option></select>
        <button class="button button--primary" type="submit">ذخیره اطلاعات</button>
    </form><p class="form-hint"><a href="/Profile">بازگشت به حساب</a></p>
</section>
