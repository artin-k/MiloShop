@model MiloShop.Web.ViewModels.Profile.DashboardVM
@{ ViewData["Title"] = "حساب شما | میلوشاپ"; }
<header class="storefront-heading"><p class="eyebrow">YOUR SPACE / MILOSHOP</p><h1>سلام، @(Model.FullName ?? Model.UserName).</h1><p>اطلاعات حساب و وضعیت خریدهای شما.</p></header>
@if (TempData["ProfileSaved"] is string message) { <p class="notice" role="status">@message</p> }
<div class="two-columns">
    <section class="panel"><h2>حساب من</h2><dl class="totals"><dt>نام کاربری</dt><dd>@Model.UserName</dd><dt>ایمیل</dt><dd>@Model.Email</dd><dt>تلفن</dt><dd>@(Model.PhoneNumber ?? "ثبت نشده")</dd><dt>سفارش‌ها</dt><dd>@Model.OrdersCount</dd><dt>آدرس</dt><dd>@(Model.Address ?? "ثبت نشده")</dd></dl><div class="actions"><a class="button" href="/Profile/Edit">ویرایش اطلاعات</a><a class="button" href="/Cart">سبد خرید (@Model.CartItems.Count)</a></div></section>
    <aside class="panel"><h2>فصل بعدی شما.</h2><p>انتخاب‌های تازه میلو را ببینید و ایده بعدی خودتان را شروع کنید.</p><div class="actions"><a class="button button--primary" href="/Shop">فروشگاه ←</a><form asp-controller="Auth" asp-action="Logout" method="post"><button class="button" type="submit">خروج</button></form></div></aside>
</div>
<section class="panel"><h2>سفارش‌های اخیر</h2>
    @if (!Model.Orders.Any()) { <p>هنوز سفارشی ثبت نکرده‌اید.</p> }
    else
    {
        <div class="table-wrap"><table><thead><tr><th>شماره سفارش</th><th>تاریخ</th><th>وضعیت</th><th>مبلغ</th></tr></thead><tbody>
        @foreach (var order in Model.Orders)
        {
            <tr><td>#@order.Id</td><td>@order.OrderedAt.ToLocalTime().ToString("yyyy/MM/dd")</td><td>@order.Status</td><td>@((order.FinalAmount ?? order.TotalAmount).ToString("N0")) تومان</td></tr>
        }
        </tbody></table></div>
    }
</section>
