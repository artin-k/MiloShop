@model MiloShop.Web.ViewModels.CartViewModel
@{ ViewData["Title"] = "سبد خرید | میلوشاپ"; }
<header class="storefront-heading"><p class="eyebrow">YOUR SELECTION</p><h1>انتخاب‌های شما.</h1></header>
@if (!Model.Items.Any())
{
    <section class="empty"><h2>سبد خریدت هنوز خالی است.</h2><p>یک انتخاب تازه منتظر شماست.</p><a class="button" href="/Shop">کشف فروشگاه ←</a></section>
}
else
{
    <div class="two-columns">
        <section class="panel table-wrap" aria-label="اقلام سبد خرید">
            <table><thead><tr><th>محصول</th><th>تعداد</th><th>مبلغ</th><th></th></tr></thead><tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><a class="cart-product" asp-route="ProductDetails" asp-route-id="@item.ProductId"><img src="@(item.ProductImageUrl ?? "/images/hero/hero3.jpg")" alt="" /><span>@item.ProductName</span></a></td>
                    <td>@item.Quantity</td><td>@((item.UnitPrice * item.Quantity).ToString("N0")) تومان</td>
                    <td><form asp-controller="Cart" asp-action="Remove" method="post"><input type="hidden" name="cartItemId" value="@item.Id" /><button class="button" type="submit" aria-label="حذف @item.ProductName">حذف</button></form></td>
                </tr>
            }
            </tbody></table>
        </section>
        <aside class="panel">
            <h2>خلاصه خرید</h2>
            <dl class="totals"><dt>جمع محصولات</dt><dd>@Model.Subtotal.ToString("N0") تومان</dd><dt>تخفیف</dt><dd>@Model.DiscountAmount.ToString("N0") تومان</dd><dt>مبلغ نهایی</dt><dd>@Model.FinalTotal.ToString("N0") تومان</dd></dl>
            <form asp-controller="Cart" asp-action="ApplyCoupon" method="post"><label for="code">کد تخفیف</label><input id="code" name="code" value="@Model.CouponCode" /><div class="actions"><button class="button" type="submit">اعمال کد</button></div></form>
            @if (!string.IsNullOrWhiteSpace(Model.CouponMessage)) { <p class="notice" role="status">@Model.CouponMessage</p> }
            <div class="actions"><a class="button button--primary" asp-controller="Cart" asp-action="Checkout" asp-route-couponCode="@Model.CouponCode">ادامه سفارش ←</a></div>
        </aside>
    </div>
}
