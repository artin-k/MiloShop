@model MiloShop.Web.ViewModels.CheckoutViewModel
@{ ViewData["Title"] = "ثبت سفارش | میلوشاپ"; }
<header class="storefront-heading"><p class="eyebrow">ONE LAST STEP</p><h1>جزئیات آخر، برای شروع تازه.</h1><p>اطلاعات تحویل را وارد کنید. سفارش برای بررسی فروشگاه ثبت می‌شود.</p></header>
<form asp-controller="Cart" asp-action="Checkout" method="post">
    <input asp-for="CouponCode" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="error" role="alert"></div>
    <div class="two-columns">
        <section class="panel"><h2>اطلاعات تحویل</h2><div class="form-grid">
            <div><label asp-for="FullName">نام و نام خانوادگی</label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="error"></span></div>
            <div><label asp-for="PhoneNumber">شماره تماس</label><input asp-for="PhoneNumber" autocomplete="tel" /><span asp-validation-for="PhoneNumber" class="error"></span></div>
            <div><label asp-for="PostalCode">کد پستی (اختیاری)</label><input asp-for="PostalCode" autocomplete="postal-code" /><span asp-validation-for="PostalCode" class="error"></span></div>
            <div class="wide"><label asp-for="Address">آدرس تحویل</label><textarea asp-for="Address" rows="3" autocomplete="street-address"></textarea><span asp-validation-for="Address" class="error"></span></div>
            <div class="wide"><label asp-for="Note">توضیحات سفارش</label><textarea asp-for="Note" rows="2"></textarea><span asp-validation-for="Note" class="error"></span></div>
        </div></section>
        <aside class="panel"><h2>سفارش شما</h2>
            @foreach (var item in Model.Items) { <p>@item.ProductName × @item.Quantity <span class="price">@((item.UnitPrice * item.Quantity).ToString("N0")) تومان</span></p> }
            <dl class="totals"><dt>جمع</dt><dd>@Model.Subtotal.ToString("N0") تومان</dd><dt>تخفیف</dt><dd>@Model.DiscountAmount.ToString("N0") تومان</dd><dt>نهایی</dt><dd>@Model.FinalTotal.ToString("N0") تومان</dd></dl>
            @if (!string.IsNullOrWhiteSpace(Model.CouponMessage)) { <p class="notice">@Model.CouponMessage</p> }
            <span asp-validation-for="CouponCode" class="error"></span>
            <label class="check-inline"><input asp-for="ConfirmPurchase" /> اطلاعات سفارش را بررسی و تأیید می‌کنم.</label>
            <span asp-validation-for="ConfirmPurchase" class="error"></span>
            <div class="actions"><button class="button button--primary" type="submit">ثبت سفارش ←</button><a href="/Cart">بازگشت به سبد</a></div>
        </aside>
    </div>
</form>
