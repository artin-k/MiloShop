@using MiloShop.Web.ViewModels.Home
@model HomePageViewModel
<section class="studio-section" id="pathways" aria-labelledby="collections-title">
    <div class="studio-shell feature-shell">
        <header class="feature-heading">
            <h2 id="collections-title">@Model.Content["FeaturesTitle"]</h2>
            <p>@Model.Content["FeaturesIntro"]</p>
        </header>
        <div class="feature-grid">
            @for (var i = 1; i <= HomepageContent.FeatureCount; i++)
            {
                var key = $"Feature{i}";
                <a asp-route="ShopIndex" asp-route-q='@Model.Content[key + "Query"]' class="feature-cell">
                    <h3><partial name="_Icon" model='Model.Content[key + "Icon"]' /> @Model.Content[key + "Title"]</h3>
                    <p>@Model.Content[key + "Description"]</p>
                </a>
            }
        </div>
        <a class="text-link" asp-route="ShopIndex">همه محصولات ←</a>
    </div>
</section>
