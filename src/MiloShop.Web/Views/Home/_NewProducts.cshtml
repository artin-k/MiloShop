@model MiloShop.Web.ViewModels.Home.HomePageViewModel
@{ var products = Model.NewProducts; }
    <section class="milo-section milo-section--products" aria-labelledby="new-title">
        <div class="milo-shell">
            <header class="milo-section__head">
<div>
<p class="milo-kicker">تازه روی میز</p>
<h2 id="new-title">انتخاب‌های تازه میلو</h2>
</div>
<a class="milo-inline-link" asp-route="ShopIndex" asp-route-sort="new">مشاهده همه <i class="fa-solid fa-arrow-left">
</i>
</a>
</header>
            @if (products.Any())
            {
                <div class="milo-products">
                    @foreach (var product in products)
                    {
                        <partial name="_ProductCard" model="product" />
                    }
                </div>
            }
            else
            {
                <div class="milo-empty-products">
<div class="milo-empty-products__visual">
<img src="~/images/hero/hero3.jpg" alt="مجموعه نوشت‌افزار رنگی" />
</div>
<div>
<p class="milo-kicker">قفسه‌ها در حال چیده شدن‌اند</p>
<h3>به‌زودی انتخاب‌های تازه اینجا هستند.</h3>
<p>فعلاً می‌توانید مجموعه کامل فروشگاه را ببینید.</p>
<a class="milo-button milo-button--primary" asp-route="ShopIndex">رفتن به فروشگاه</a>
</div>
</div>
            }
        </div>
    </section>
