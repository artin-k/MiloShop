@model MiloShop.Web.ViewModels.Home.HomePageViewModel
<section class="sec fin" id="eternity" data-cam="4">
  <!-- foreground: the closing horizon: hill, ruins, grass, and the last branch -->
  <div class="fg" data-fg="eternity" aria-hidden="true">
    <span class="fg-el fg-hill" data-fg-in="up">
      <img crossorigin="anonymous" src="/vendor/threeui/secret-pathways-assets/foreground/png/hill.webp" alt="" width="1774" height="887" loading="lazy" decoding="async">
    </span>
    <span class="fg-el fg-ruins" data-fg-in="left">
      <img crossorigin="anonymous" src="/vendor/threeui/secret-pathways-assets/foreground/png/shrine-ruins.webp" alt="" width="1536" height="1001" loading="lazy" decoding="async">
    </span>
    <span class="fg-el fg-grass" data-fg-in="up">
      <img crossorigin="anonymous" src="/vendor/threeui/secret-pathways-assets/foreground/png/tall-grass.webp" alt="" width="1717" height="916" loading="lazy" decoding="async">
    </span>
    <span class="fg-el fg-sakura" data-fg-in="left">
      <img crossorigin="anonymous" src="/vendor/threeui/secret-pathways-assets/foreground/png/sakura-branch.webp" alt="" width="1536" height="1024" loading="lazy" decoding="async">
    </span>
  </div>
  <div class="eyebrow" data-rv="fade">فصل بعدی، با شماست</div>
  <h2 class="display" data-rv="up">از یک ایده<br>شروع کن.</h2>
  <p class="body-lg" data-rv="up">برای شروع لازم نیست همه چیز آماده باشد. یک دفتر، یک قلم، و کمی کنجکاوی کافی است.</p>
  <a class="cta" href="/Shop" data-rv="fade" data-cursor>
    <i></i><span>ورود به فروشگاه</span>
    <svg viewBox="0 0 14 14" fill="none" width="13" height="13"><path d="M3 11 11 3M5 3h6v6" stroke="#dfe7e0" stroke-width="1.3"/></svg>
  </a>
</section>
