<div class="imagination-orb" data-imagination-orb>
    <div class="orb-stage">
        <svg class="orb-fallback" viewBox="0 0 360 300" aria-hidden="true">
            <defs>
                <pattern id="orb-paper-dots" width="4.5" height="4.5" patternUnits="userSpaceOnUse" patternTransform="rotate(14)">
                    <circle cx="1" cy="1" r=".85" fill="currentColor" />
                </pattern>
            </defs>
            <g fill="url(#orb-paper-dots)">
                <path d="M39 100 114 127 144 178Z M114 127 115 23 160 69Z M114 127 160 69 197 136Z" opacity=".60" />
                <path d="M114 127 197 136 144 178Z M144 178 65 243 151 217Z M144 178 197 136 151 217Z" opacity=".90" />
                <path d="M151 217 197 136 240 166Z M197 136 260 64 240 166Z" opacity=".7" />
                <path d="M240 166 260 64 275 86Z M260 64 275 86 313 98Z" />
            </g>
        </svg>
        <canvas aria-hidden="true"></canvas>
    </div>
    <div class="orb-controls" hidden>
        <div class="orb-steps" role="group" aria-label="شکل‌های خیال">
            <button type="button" data-orb-shape="bird" aria-label="پرندهٔ کاغذی" aria-pressed="true"><partial name="_Icon" model="@("bird")" /></button>
            <button type="button" data-orb-shape="lamp" aria-label="چراغ مطالعه" aria-pressed="false"><partial name="_Icon" model="@("lamp")" /></button>
            <button type="button" data-orb-shape="plane" aria-label="هواپیمای کاغذی" aria-pressed="false"><partial name="_Icon" model="@("plane")" /></button>
            <button type="button" data-orb-shape="star" aria-label="ستارهٔ خیال" aria-pressed="false"><partial name="_Icon" model="@("star")" /></button>
            <button type="button" data-orb-shape="boat" aria-label="قایق کاغذی" aria-pressed="false"><partial name="_Icon" model="@("boat")" /></button>
            <button type="button" data-orb-shape="gift" aria-label="جعبهٔ هدیه" aria-pressed="false"><partial name="_Icon" model="@("gift")" /></button>
        </div>
        <button class="orb-pause" type="button" data-orb-pause aria-label="توقف پویانمایی" aria-pressed="false">
            <svg data-orb-pause-icon viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 5v10M13 5v10" stroke="currentColor" stroke-width="1.5" /></svg>
            <svg data-orb-play-icon viewBox="0 0 20 20" fill="none" aria-hidden="true" hidden><path d="m7 4 9 6-9 6V4Z" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
    </div>
</div>
