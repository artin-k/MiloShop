<figure class="imagination-orb" data-imagination-orb aria-labelledby="imagination-title">
    <div class="orb-topline" aria-hidden="true"><span class="orb-live-dot"></span><span dir="ltr">A LITTLE INK. AN INFINITE WORLD.</span><span>میلو / استودیو خیال</span></div>
    <div class="orb-stage">
        <span class="orb-coordinate orb-coordinate--top" aria-hidden="true">+ BEGIN ANYWHERE</span>
        <svg class="orb-fallback" viewBox="0 0 600 540" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M300 181C259 146 209 143 145 157V351C207 338 255 340 300 375C345 340 393 338 455 351V157C391 143 341 146 300 181Z" stroke-width="3" stroke-dasharray="1 8" />
                <path d="M300 181V375M170 191C211 184 247 190 277 207M170 225C211 218 247 224 277 241M170 259C211 252 247 258 277 275M170 293C211 286 247 292 277 309M323 207C353 190 389 184 430 191M323 241C353 224 389 218 430 225M323 275C353 258 389 252 430 259M323 309C353 292 389 286 430 293" stroke-width="2.5" stroke-dasharray="1 8" />
                <ellipse cx="300" cy="272" rx="228" ry="169" transform="rotate(-22 300 272)" opacity=".2" stroke-dasharray="1 14" />
            </g>
        </svg>
        <canvas aria-hidden="true"></canvas>
        <span class="orb-coordinate orb-coordinate--bottom" aria-hidden="true">IMAGINATION, TAKING SHAPE +</span>
    </div>
    <figcaption class="orb-caption">
        <div><span class="orb-eyebrow">از کاغذ تا خیال</span><strong id="imagination-title" data-orb-title>صفحه‌ای برای شروع</strong><p data-orb-description>فکرهای کوچک را بنویس؛ این اولین شکل یک رویای بزرگ است.</p></div>
        <span class="orb-count" aria-hidden="true" dir="ltr"><span data-orb-count>01</span> / 04</span>
    </figcaption>
    <div class="orb-controls" hidden>
        <div class="orb-steps" role="group" aria-label="شکل‌های خیال">
            <button type="button" data-orb-shape="0" aria-label="نمایش دفتر باز" aria-pressed="true"><span>۰۱</span> دفتر</button>
            <button type="button" data-orb-shape="1" aria-label="نمایش نوک قلم" aria-pressed="false"><span>۰۲</span> قلم</button>
            <button type="button" data-orb-shape="2" aria-label="نمایش هواپیمای کاغذی" aria-pressed="false"><span>۰۳</span> پرواز</button>
            <button type="button" data-orb-shape="3" aria-label="نمایش ستاره خیال" aria-pressed="false"><span>۰۴</span> رویا</button>
        </div>
        <button class="orb-pause" type="button" data-orb-pause aria-label="توقف پویانمایی" aria-pressed="false">
            <svg data-orb-pause-icon viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7 5v10M13 5v10" stroke="currentColor" stroke-width="1.5" /></svg>
            <svg data-orb-play-icon viewBox="0 0 20 20" fill="none" aria-hidden="true" hidden><path d="m7 4 9 6-9 6V4Z" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
    </div>
</figure>
