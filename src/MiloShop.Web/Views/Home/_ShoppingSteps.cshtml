@model MiloShop.Web.ViewModels.Home.HomePageViewModel
    <section class="milo-story" aria-labelledby="story-title">
<div class="milo-shell">
        <div class="milo-story__intro">
<p class="milo-kicker">خرید، بدون شلوغی</p>
<h2 id="story-title">ما انتخاب کردن را ساده نگه می‌داریم.</h2>
<p>به‌جای صدها انتخاب گیج‌کننده، محصولاتی کاربردی و خوش‌ساخت را کنار هم می‌گذاریم تا شما سریع‌تر به چیزی که می‌خواهید برسید.</p>
</div>
        <ol class="milo-steps">
<li>
<span>01</span>
<i class="fa-solid fa-magnifying-glass">
</i>
<div>
<h3>پیدا کن</h3>
<p>با دسته‌بندی و جست‌وجوی ساده.</p>
</div>
</li>
<li>
<span>02</span>
<i class="fa-solid fa-basket-shopping">
</i>
<div>
<h3>انتخاب کن</h3>
<p>قیمت و موجودی شفاف، بدون حدس.</p>
</div>
</li>
<li>
<span>03</span>
<i class="fa-solid fa-box-open">
</i>
<div>
<h3>تحویل بگیر</h3>
<p>پرداخت امن و پیگیری سفارش.</p>
</div>
</li>
</ol>
    </div>
</section>
