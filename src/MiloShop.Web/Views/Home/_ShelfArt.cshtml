@model Product
@if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
{
    var isSvg = Model.ImageUrl.EndsWith(".svg", StringComparison.OrdinalIgnoreCase);
    <img class="shelf-art @(isSvg ? "shelf-art--icon" : null)" src="@Model.ImageUrl" alt="" width="160" height="@(isSvg ? 160 : 240)" loading="lazy" decoding="async" draggable="false" />
}
else
{
    var cover = Model.Category?.Icon ?? StationeryIcon.ForCategory(Model.Category?.Name);
    <span class="shelf-art shelf-art--cover" data-cover="@cover"><partial name="_NotebookCover" model="cover" /></span>
}
