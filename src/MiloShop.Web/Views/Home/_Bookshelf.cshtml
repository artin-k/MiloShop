@model MiloShop.Web.ViewModels.Home.HomePageViewModel
@{ var items = Model.Collections; }
<section class="studio-section bookshelf-section" id="bookshelf" data-bookshelf-section="@(items.Count > 0 ? "categories" : "empty")" data-bookshelf-state="idle" aria-labelledby="bookshelf-title">
    <div class="studio-shell">
        <header class="studio-heading">
            <h2 id="bookshelf-title">@Model.Content["CollectionsTitle"]</h2>
            <a class="text-link" asp-route="ShopIndex">همه محصولات ←</a>
        </header>
        @if (items.Count > 0)
        {
            var first = items[0];
            <ul class="category-shelf" aria-label="دسته‌بندی‌های فروشگاه">
                @foreach (var category in items)
                {
                    var icon = category.Icon ?? StationeryIcon.ForCategory(category.Name);
                    <li>
                        <a class="category-card" asp-route="ShopIndex" asp-route-categoryId="@category.Id"
                           data-cover="@icon">
                            @if (category.Icon == null && !string.IsNullOrWhiteSpace(category.ImageUrl))
                            {
                                <img class="category-icon" src="@category.ImageUrl" alt="" width="36" height="36" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <span class="category-icon"><partial name="_Icon" model="icon" /></span>
                            }
                            <div class="category-card__copy">
                                <strong>@category.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(category.Description))
                                {
                                    <span class="category-card__spec">@category.Description</span>
                                }
                                <small>@(category.AvailableProductCount > 0 ? $"{category.AvailableProductCount} محصول موجود" : "به‌زودی")</small>
                            </div>
                        </a>
                    </li>
                }
            </ul>
            <details class="bookshelf-experience" data-bookshelf-experience hidden>
                <summary><partial name="_Icon" model="@("collections")" /> قفسه سه‌بعدی</summary>
                <p id="bookshelf-instructions" class="bookshelf-intro">کتاب‌ها را انتخاب کنید و صفحه‌ها را ورق بزنید.</p>
                <script type="application/json" data-bookshelf-categories>@Json.Serialize(items.Select(category => new {
                    id = category.Id, title = category.Name, description = category.Description,
                    productCount = category.AvailableProductCount, icon = category.Icon,
                    url = Url.RouteUrl("ShopIndex", new { categoryId = category.Id })
                }))</script>
                <div class="bookshelf-stage">
                    <div class="bookshelf-frame" data-bookshelf-mount dir="ltr" aria-describedby="bookshelf-instructions"></div>
                    <div class="bookshelf-placeholder" aria-hidden="true"><partial name="_NotebookCover" model="@("notebook")" /></div>
                </div>
                <div class="bookshelf-toolbar">
                    <div class="bookshelf-selection"><strong data-bookshelf-title>@first.Name</strong><span data-bookshelf-counter dir="ltr">01 / @items.Count.ToString("D2")</span><span data-bookshelf-page dir="ltr"></span></div>
                    <div class="bookshelf-actions" aria-label="کنترل مجموعه‌ها">
                        <button class="button" type="button" data-bookshelf-start>نمایش مجموعه‌ها</button>
                        <button class="button" type="button" data-bookshelf-action="previous" disabled>دسته قبل</button>
                        <button class="button" type="button" data-bookshelf-action="next" disabled>دسته بعد</button>
                        <button class="button" type="button" data-bookshelf-action="inspect" disabled>کشف مجموعه</button>
                        <button class="button" type="button" data-bookshelf-action="toggle-book" aria-pressed="false" hidden>باز کردن دفتر</button>
                        <button class="button" type="button" data-bookshelf-action="previous-page" hidden>صفحه قبل</button>
                        <button class="button" type="button" data-bookshelf-action="next-page" hidden>صفحه بعد</button>
                        <button class="button" type="button" data-bookshelf-action="reset-view" hidden>بازنشانی زاویه</button>
                        <button class="button" type="button" data-bookshelf-action="close-detail" hidden>بازگشت به مجموعه‌ها</button>
                    </div>
                </div>
                <div class="bookshelf-shopping">
                    <div><p data-bookshelf-summary>@first.Description</p><span data-bookshelf-product-count>@(first.AvailableProductCount > 0 ? $"{first.AvailableProductCount} محصول موجود" : "این مجموعه در حال تکمیل است")</span></div>
                    <a class="button button--primary" data-bookshelf-shop asp-route="ShopIndex" asp-route-categoryId="@first.Id">دیدن محصولات @first.Name ←</a>
                </div>
                <div class="bookshelf-volumes" role="group" aria-label="انتخاب دسته‌بندی">
                    @for (var i = 0; i < items.Count; i++) { <button type="button" data-bookshelf-volume="@i" aria-pressed="@(i == 0 ? "true" : "false")" disabled>@items[i].Name</button> }
                </div>
                <p class="bookshelf-status" data-bookshelf-status role="status"></p>
            </details>
        }
        else
        {
            <p class="notice">مجموعه‌های میلو به‌زودی اینجا قرار می‌گیرند. تا آن زمان <a href="/Shop">محصولات فروشگاه را ببینید.</a></p>
        }
    </div>
</section>
