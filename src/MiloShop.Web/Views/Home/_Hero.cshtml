@model MiloShop.Web.ViewModels.Home.HomePageViewModel
<section class="milo-hero" aria-labelledby="hero-title">
    <div class="milo-shell milo-hero__grid">
        <div class="milo-hero__copy">
            <p class="milo-eyebrow">
<span>
</span> از فکر تا کاغذ، با میلو</p>
            <h1 id="hero-title">برای ایده‌هایی که هنوز <em>روی کاغذ</em> نیامده‌اند.</h1>
            <p class="milo-hero__lead">نوشت‌افزار، ابزار خلاقیت و هدیه‌هایی که با دقت انتخاب شده‌اند؛ برای مدرسه، کار و لحظه‌های شخصی شما.</p>
            <div class="milo-actions">
                <a class="milo-button milo-button--primary" asp-route="ShopIndex">ورود به فروشگاه <i class="fa-solid fa-arrow-left" aria-hidden="true">
</i>
</a>
                <a class="milo-button milo-button--text" href="#collections">دیدن مجموعه‌ها</a>
            </div>
            <ul class="milo-trust" aria-label="مزایای خرید از میلوشاپ">
                <li>
<i class="fa-solid fa-check">
</i> انتخاب‌های باکیفیت</li>
                <li>
<i class="fa-solid fa-check">
</i> پرداخت امن</li>
                <li>
<i class="fa-solid fa-check">
</i> ارسال سریع</li>
            </ul>
        </div>

        <div class="milo-hero__art" aria-label="مجموعه‌ای از لوازم‌التحریر رنگی">
            <figure class="milo-photo milo-photo--main">
<img src="~/images/hero/hero2.jpg" alt="دفترها و مدادهای رنگی" />
</figure>
        </div>
    </div>
</section>
