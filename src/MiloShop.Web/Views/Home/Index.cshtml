@model MiloShop.Web.ViewModels.Home.HomePageViewModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider AssetVersions
@{
    ViewData["Title"] = "میلو | کاغذ، قلم و ابزار خلاقیت";
    ViewData["Description"] = "نوشت‌افزار، دفتر، ابزار طراحی و لوازم میز کار در میلو؛ مشخصات را مقایسه کنید و انتخاب متناسب با کار خودتان را پیدا کنید.";
    ViewData["Home"] = true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/stationery.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/imagination-orb.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bookshelf.css" asp-append-version="true" />
}
@section Scripts {
    @{
        var shapeModule = AssetVersions.AddFileVersionToPath(Context.Request.PathBase, Url.Content("~/js/imagination-shapes.js"));
    }
    <!script type="importmap">@Json.Serialize(new { imports = new Dictionary<string, string> { ["milo-imagination-shapes"] = shapeModule } })</!script>
    <script type="module" src="~/js/imagination-orb.js" asp-append-version="true"></script>
    @if (Model.Testimonials.Count > 1)
    {
        <script type="module" src="~/js/testimonials.js" asp-append-version="true"></script>
    }
    @if (Model.Collections.Count > 0)
    {
        <script type="module" src="~/vendor/bookshelf/bookshelf-loader.js" asp-append-version="true"></script>
    }
}
<section class="paper-hero" id="hero" aria-labelledby="hero-title">
    <div class="studio-shell paper-hero__grid">
        <div class="paper-hero__copy">
            <h1 id="hero-title">ایده‌هایت را بنویس.<br /><em>رویاهایت را شکل بده.</em></h1>
            <div class="actions"><a class="button button--primary" href="/Shop">کشف نوشت‌افزار ←</a><a class="button" href="#bookshelf">دیدن مجموعه‌ها</a></div>
        </div>
        <partial name="_ImaginationOrb" />
    </div>
</section>
<partial name="_Bookshelf" model="Model.Collections" />
<partial name="_Features" />
<section class="studio-section" id="lessons" aria-labelledby="arrivals-title"><div class="studio-shell">
    <header class="studio-heading"><div><p class="eyebrow">تازه روی میز میلو</p><h2 id="arrivals-title">انتخاب بعدی شما، همین‌جاست.</h2></div><a class="text-link" href="/Shop?sort=new">جدیدترین‌ها ←</a></header>
    @if (Model.ActiveCoupon is not null) { <p class="notice">کد تخفیف فعال: <strong>@Model.ActiveCoupon.Code</strong> <button class="button" type="button" data-code="@Model.ActiveCoupon.Code">کپی کد</button></p> }
    <div class="product-grid">
        @foreach (var product in Model.NewProducts) { <partial name="_ProductCard" model="product" /> }
    </div>
    @if (!Model.NewProducts.Any()) { <p class="catalog-empty">هنوز محصولی در این مجموعه ثبت نشده است. <a href="/Shop">فروشگاه را ببینید.</a></p> }
</div></section>
<section class="studio-section" id="gate" aria-labelledby="desk-title"><div class="studio-shell desk-spread">
    <figure><img src="/images/studio/desk-1-736.webp" srcset="/images/studio/desk-1-360.webp 360w, /images/studio/desk-1-736.webp 736w" sizes="(max-width: 820px) calc(100vw - 32px), 40vw" width="736" height="1104" loading="lazy" decoding="async" alt="چیدمان دفتر، قلم و ابزار کار روزانه" /></figure>
    <div><p class="eyebrow">COMPLETE THE DESK</p><h2 id="desk-title">میزت را، به سبک خودت کامل کن.</h2><p>به جای انتخاب یک ست از پیش تعیین‌شده، ابزارهای میز مطالعه یا استودیو را جداگانه و متناسب با نیازت کنار هم بگذار.</p>
    <ul class="desk-list"><li><a href="/Shop?q=دفتر">یک دفتر برای فکرها</a><span>یادداشت و برنامه‌ریزی</span></li><li><a href="/Shop?q=قلم">یک قلم برای شروع</a><span>نوشتن و طراحی</span></li><li><a href="/Shop?q=جامدادی">جایی برای ابزارها</a><span>نظم و دسترسی</span></li></ul>
    <p>جنس و برند ثبت‌شده را روی کارت‌ها ببین و تا سه محصول را کنار هم مقایسه کن.</p></div>
</div></section>
<section class="studio-section" id="eternity">
    <div class="studio-shell studio-closing">
        <p class="eyebrow">میلو / ابزار ایده‌های تازه</p>
        <h2>صفحه بعدی را، خودت بنویس.</h2><div class="actions">
            <a class="button button--primary" href="/Shop">رفتن به فروشگاه ←</a>
            <a class="text-link" href="#bookshelf">کشف مجموعه‌های میلو</a>
            </div>
    </div>
</section>
<partial name="_Testimonials" model="Model.Testimonials" />
