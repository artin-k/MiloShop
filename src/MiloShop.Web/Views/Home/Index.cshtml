@model MiloShop.Web.ViewModels.Home.HomePageViewModel
@{
    ViewData["Title"] = "میلو | کاغذ، قلم و ابزار خلاقیت";
    ViewData["Description"] = "نوشت‌افزار، دفتر، ابزار طراحی و لوازم میز کار در میلو؛ مشخصات را مقایسه کنید و انتخاب متناسب با کار خودتان را پیدا کنید.";
    ViewData["Home"] = true;
}
@section Styles {
    <link rel="stylesheet" href="~/css/stationery.css" asp-append-version="true" />
}
@section Head {
    <link rel="preload" as="image" href="/images/studio/desk-2-736.webp" imagesrcset="/images/studio/desk-2-360.webp 360w, /images/studio/desk-2-736.webp 736w" imagesizes="(max-width: 820px) calc(100vw - 32px), 45vw" fetchpriority="high" />
}
<section class="paper-hero" id="hero" aria-labelledby="hero-title">
    <div class="studio-shell paper-hero__grid">
        <div class="paper-hero__copy">
            <p class="eyebrow">MILO — PAPER, PENS & POSSIBILITIES</p>
            <h1 id="hero-title">فکرهای بزرگ،<br />از یک <em>صفحه سفید</em><br />شروع می‌شوند.</h1>
            <p>برای یادداشت‌های روزانه، طرح‌های ناتمام و میز کاری که دوستش داری. دفتر، قلم و ابزار مناسب کار خودت را در میلو پیدا کن.</p>
            <div class="actions"><a class="button button--primary" href="/Shop">کشف نوشت‌افزار ←</a><a class="text-link" href="#pathways">برای چه کاری می‌خواهی؟</a></div>
        </div>
        <figure class="paper-hero__photo">
            <img src="/images/studio/desk-2-736.webp" srcset="/images/studio/desk-2-360.webp 360w, /images/studio/desk-2-736.webp 736w" sizes="(max-width: 820px) calc(100vw - 32px), 45vw" width="736" height="1104" loading="eager" fetchpriority="high" decoding="async" alt="دفترهای رنگی، قلم و ابزار یادداشت روی میز" />
            <figcaption><span>ابزار کوچک، امکان‌های بی‌انتها.</span><span dir="ltr">THE EVERYDAY STUDIO / 01</span></figcaption>
        </figure>
    </div>
</section>
<section class="studio-section" id="pathways" aria-labelledby="collections-title"><div class="studio-shell">
    <header class="studio-heading"><div><p class="eyebrow">برای شیوه کار شما</p><h2 id="collections-title">هر میز، یک دنیای متفاوت.</h2></div><a class="text-link" href="/Shop">همه محصولات ←</a></header>
    <div class="use-cases">
        <article class="use-case"><span>01 / JOURNAL</span><h3>نوشتن و یادداشت</h3><p>دفترها و ابزار ثبت فکر؛ برای برنامه روزانه، کلاس و ژورنال شخصی.</p><a class="text-link" href="/Shop?q=دفتر">دفترها را ببین ←</a></article>
        <article class="use-case"><span>02 / SKETCH</span><h3>طراحی و ایده‌پردازی</h3><p>از اولین خط تا طرح نهایی؛ ابزارها را بر اساس مشخصات محصول انتخاب کن.</p><a class="text-link" href="/Shop?q=طراحی">ابزار طراحی ←</a></article>
        <article class="use-case"><span>03 / DESK</span><h3>میز منظم، فکر آزاد</h3><p>برای جمع‌وجور کردن ابزار روزانه و ساختن یک فضای کار دلخواه.</p><a class="text-link" href="/Shop?q=جامدادی">نظم‌دهنده‌های میز ←</a></article>
    </div>
    <div class="category-links" aria-label="دسته‌بندی‌های فروشگاه">
        @foreach (var category in Model.Categories) { <a asp-route="ShopIndex" asp-route-categoryId="@category.Id">@category.Name</a> }
    </div>
</div></section>
<section class="studio-section" id="lessons" aria-labelledby="arrivals-title"><div class="studio-shell">
    <header class="studio-heading"><div><p class="eyebrow">تازه روی میز میلو</p><h2 id="arrivals-title">انتخاب بعدی شما، همین‌جاست.</h2></div><a class="text-link" href="/Shop?sort=new">جدیدترین‌ها ←</a></header>
    @if (Model.ActiveCoupon is not null) { <p class="notice">کد تخفیف فعال: <strong>@Model.ActiveCoupon.Code</strong> <button class="button" type="button" data-code="@Model.ActiveCoupon.Code">کپی کد</button></p> }
    <div class="product-grid">
        @foreach (var product in Model.NewProducts) { <partial name="_ProductCard" model="product" /> }
    </div>
    @if (!Model.NewProducts.Any()) { <p class="catalog-empty">هنوز محصولی در این مجموعه ثبت نشده است. <a href="/Shop">فروشگاه را ببینید.</a></p> }
</div></section>
<section class="studio-section" id="gate" aria-labelledby="desk-title"><div class="studio-shell desk-spread">
    <figure><img src="/images/studio/desk-1-736.webp" srcset="/images/studio/desk-1-360.webp 360w, /images/studio/desk-1-736.webp 736w" sizes="(max-width: 820px) calc(100vw - 32px), 40vw" width="736" height="1104" loading="lazy" decoding="async" alt="چیدمان دفتر، قلم و ابزار کار روزانه" /></figure>
    <div><p class="eyebrow">COMPLETE THE DESK</p><h2 id="desk-title">میزت را، به سبک خودت کامل کن.</h2><p>به جای انتخاب یک ست از پیش تعیین‌شده، ابزارهای میز مطالعه یا استودیو را جداگانه و متناسب با نیازت کنار هم بگذار.</p>
    <ul class="desk-list"><li><a href="/Shop?q=دفتر">یک دفتر برای فکرها</a><span>یادداشت و برنامه‌ریزی</span></li><li><a href="/Shop?q=قلم">یک قلم برای شروع</a><span>نوشتن و طراحی</span></li><li><a href="/Shop?q=جامدادی">جایی برای ابزارها</a><span>نظم و دسترسی</span></li></ul>
    <p>جنس و برند ثبت‌شده را روی کارت‌ها ببین و تا سه محصول را کنار هم مقایسه کن.</p></div>
</div></section>
<section class="studio-section" id="eternity"><div class="studio-shell studio-closing"><p class="eyebrow">میلو / ابزار ایده‌های تازه</p><h2>صفحه بعدی را، خودت بنویس.</h2><div class="actions"><a class="button button--primary" href="/Shop">رفتن به فروشگاه ←</a><a class="text-link" href="/Studio">تجربه تعاملی ThreeUI</a></div></div></section>
