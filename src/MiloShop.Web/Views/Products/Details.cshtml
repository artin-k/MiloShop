@model MiloShop.Domain.Entities.Product
@using System.Text.Json
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.ShortDescription ?? Model.Title;
    ViewBag.BodyClass = "storefront-page";
    var price = Model.SalePrice ?? Model.Price;
    var image = string.IsNullOrWhiteSpace(Model.ImageUrl) ? "/images/hero/hero3.jpg" : Model.ImageUrl;
    var productUrl = Url.RouteUrl("ProductDetails", new { id = Model.Id, slug = Model.Slug }, Context.Request.Scheme);
    var imageUrl = new Uri(new Uri($"{Context.Request.Scheme}://{Context.Request.Host}"), image).ToString();
}

@section Head {
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(new Dictionary<string, object> {
        ["@context"] = "https://schema.org", ["@type"] = "Product", ["name"] = Model.Title,
        ["description"] = Model.ShortDescription ?? Model.Title, ["sku"] = Model.Sku,
        ["image"] = imageUrl, ["url"] = productUrl!,
        ["offers"] = new Dictionary<string, object> {
            ["@type"] = "Offer", ["priceCurrency"] = "IRR", ["price"] = price * 10,
            ["availability"] = Model.StockQuantity > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
            ["url"] = productUrl!
        }
    }))</script>
}
<div class="storefront-shell">
    <nav class="storefront-breadcrumb" aria-label="مسیر صفحه">
        <a href="/">خانه</a><span>/</span><a asp-route="ShopIndex">فروشگاه</a><span>/</span><span>@Model.Title</span>
    </nav>
    <article class="product-detail">
        <div class="product-detail__image"><img src="@image" alt="@Model.Title" width="700" height="700" loading="eager" fetchpriority="high" decoding="async" /></div>
        <div class="product-detail__info">
            <p class="milo-kicker">@(Model.Category?.Name ?? "انتخاب میلو")</p>
            <h1>@Model.Title</h1>
            <p class="product-detail__lead">@Model.ShortDescription</p>
            <dl class="product-detail__specs">
                @if (!string.IsNullOrWhiteSpace(Model.Brand)) { <dt>برند</dt><dd>@Model.Brand</dd> }
                @if (!string.IsNullOrWhiteSpace(Model.Material)) { <dt>جنس</dt><dd>@Model.Material</dd> }
                <dt>کد محصول</dt><dd>@Model.Sku</dd>
                <dt>وضعیت</dt><dd>@(Model.StockQuantity > 0 ? "موجود در انبار" : "ناموجود")</dd>
            </dl>
            <div class="product-detail__price">
                @if (Model.SalePrice.HasValue && Model.SalePrice < Model.Price) { <del>@Model.Price.ToString("N0")</del> }
                <strong>@price.ToString("N0")</strong><span>تومان</span>
            </div>
            <form method="post" asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" asp-route-returnUrl="@Context.Request.Path">
                <button class="button button--primary" type="submit" disabled="@(Model.StockQuantity <= 0)">@(Model.StockQuantity > 0 ? "افزودن به سبد خرید" : "ناموجود")</button>
            </form>
        </div>
    </article>
    <section class="product-description" aria-labelledby="description-title">
        <h2 id="description-title">درباره محصول</h2>
        <p>@Model.Description</p>
    </section>
</div>
